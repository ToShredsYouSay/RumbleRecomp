+void StaticRecompCore::QueueCacheInvalidate(u32 address, u32 length)
+{
+  if (m_has_pending_cache_invalidate && address == m_pending_cache_end)
+  {
+    // Contiguous with the run so far (the common case: a compiled
+    // DCFlushRange/DCInvalidateRange loop calling this once per line at
+    // sequentially increasing addresses), so just extend it.
+    m_pending_cache_end += length;
+    return;
+  }
+  // Not contiguous (different address, different op, or first call this
+  // dispatch): resolve whatever was pending first, so invalidation order is
+  // preserved, then start a new pending run.
+  FlushPendingCacheInvalidate();
+  m_has_pending_cache_invalidate = true;
+  m_pending_cache_start = address;
+  m_pending_cache_end = address + length;
+}
+
+void StaticRecompCore::FlushPendingCacheInvalidate()
+{
+  if (!m_has_pending_cache_invalidate)
+    return;
+  m_has_pending_cache_invalidate = false;
+  OnICacheInvalidate(m_pending_cache_start, m_pending_cache_end - m_pending_cache_start);
+}
+
 int StaticRecompCore::ChunkIndexOf(u32 address)
 {
+  if (m_has_pending_cache_invalidate)
+    FlushPendingCacheInvalidate();
   if (!m_module_active || m_chunk_lookup_table.empty())
     return -1;
 
