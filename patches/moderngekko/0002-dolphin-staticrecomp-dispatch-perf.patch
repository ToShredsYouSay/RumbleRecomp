+// RumbleRecomp: guest-pc sampling profiler. Generated code stores ctx->pc at
+// block leaders and before memory accesses, so a racy read of m_guest.pc from
+// another thread lands within a block or two of what the CPU thread is running
+// which is enough to attribute time to guest functions, which a host RIP sampler
+// cannot do inside a 16 KiB chunk function. Waits STATICRECOMP_PC_PROFILE_START_MS
+// (default 6000) after core init, samples for STATICRECOMP_PC_PROFILE_MS
+// (default 6000), then writes "pc count" lines, hottest first.
+void StaticRecompCore::StartPcProfiler(const char* path)
+{
+  const auto env_ms = [](const char* name, long fallback) {
+    const char* value = std::getenv(name);
+    return value && *value ? std::strtol(value, nullptr, 10) : fallback;
+  };
+  const long start_ms = env_ms("STATICRECOMP_PC_PROFILE_START_MS", 6000);
+  const long duration_ms = env_ms("STATICRECOMP_PC_PROFILE_MS", 6000);
+  std::string out_path = path;
+  m_pc_profiler = std::make_unique<std::jthread>([this, start_ms, duration_ms,
+                                                  out_path](std::stop_token stop) {
+    const auto start = std::chrono::steady_clock::now() + std::chrono::milliseconds(start_ms);
+    while (!stop.stop_requested() && std::chrono::steady_clock::now() < start)
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    std::unordered_map<u32, u64> hist;
+    u64 total = 0;
+    const auto end = start + std::chrono::milliseconds(duration_ms);
+    while (!stop.stop_requested() && std::chrono::steady_clock::now() < end)
+    {
+      const u32 pc = *reinterpret_cast<volatile const u32*>(&m_guest.pc);
+      ++hist[pc];
+      ++total;
+      std::this_thread::sleep_for(std::chrono::microseconds(500));
+    }
+    std::vector<std::pair<u32, u64>> sorted(hist.begin(), hist.end());
+    std::sort(sorted.begin(), sorted.end(),
+              [](const auto& a, const auto& b) { return a.second > b.second; });
+    if (std::FILE* file = std::fopen(out_path.c_str(), "w"))
+    {
+      std::fprintf(file, "# samples %llu\n", static_cast<unsigned long long>(total));
+      for (const auto& [pc, count] : sorted)
+        std::fprintf(file, "%08x %llu\n", pc, static_cast<unsigned long long>(count));
+      std::fclose(file);
+    }
+    std::fprintf(stderr, "[staticrecomp] pc profile: %llu samples -> %s\n",
+                 static_cast<unsigned long long>(total), out_path.c_str());
+  });
+}
