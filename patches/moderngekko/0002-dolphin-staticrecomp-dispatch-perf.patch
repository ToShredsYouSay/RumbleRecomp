+// Cross-chunk direct calls (DolRecomp's dolrecomp_call_enter sites) jump from
+// one chunk straight into another, skipping the chassis between them, and
+// with it the chassis's per-dispatch checks: mod host-call hooks, forced
+// fallback ranges, lockstep/trace, and SMC chunk verification. The chassis
+// turns them off here whenever any of those needs to see every transfer.
+// Parking the depth counter at its ceiling makes every dolrecomp_call_enter()
+// refuse, so each site takes its return-to-chassis path instead. Only called
+// between dispatches, when no direct call is in flight.
+extern unsigned dolrecomp_call_depth;
+RECOMP_MODULE_EXPORT void staticrecomp_set_direct_calls(int enabled)
+{
+    dolrecomp_call_depth = enabled ? 0u : 0xFFFFFFFFu;
