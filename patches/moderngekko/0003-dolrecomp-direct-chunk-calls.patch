+// RumbleRecomp: every direct branch target in the program, sorted and unique.
+// NULL means "no table": every instruction stays a chunk entry point (the old
+// behaviour). With a table, a chunk's entry switch lists only the addresses the
+// chassis can actually resume at: block leaders (which include call-return
+// sites and the instruction after anything that exits to the chassis) and any
+// address some branch in the program targets. Every other label is then
+// referenced only by in-chunk fallthrough, which lets the compiler keep guest
+// state in host registers across it. A dispatch to a non-entry pc (e.g. after
+// an FP-unavailable trap returns mid-block) executes nothing; the chassis
+// notices and interprets up to the next entry.
+static const u32* g_entry_targets = NULL;
+static u32 g_entry_target_count = 0;
+
+void emit_set_entry_targets(const u32* targets, u32 count) {
+    g_entry_targets = count ? targets : NULL;
+    g_entry_target_count = count ? count : 0;
+}
+
+static bool address_is_branch_target(u32 addr) {
+    u32 lo = 0, hi = g_entry_target_count;
+    while (lo < hi) {
+        u32 mid = lo + (hi - lo) / 2u;
+        if (g_entry_targets[mid] < addr)
+            lo = mid + 1u;
+        else
+            hi = mid;
+    }
+    return lo < g_entry_target_count && g_entry_targets[lo] == addr;
+}
+
 // The chunk whose func_<start>() covers `addr`, or 0 if none does. Chunks tile
 // the text sections but the first one does not start on the common stride, so
 // this binary-searches rather than dividing.
@@ -1666,6 +1696,35 @@ static void emit_instruction_with_range(FILE* out, const PPCInst* inst,
         break;
 
     case PPC_OP_BCCTR:
+        // RumbleRecomp: an indirect call (bctrl: virtual calls, function
+        // pointers) gets the same treatment as a direct cross-chunk bl: run the
+        // callee through the module's own dispatcher and resume inline if it
+        // came back to the instruction after the call, instead of a
+        // return-to-chassis round trip for both the call and the return. A
+        // target the module does not cover leaves pc at the target and falls
+        // back to the chassis exactly as before.
+        if (inst->lk && g_chunk_starts &&
+            branch_target_is_local(func_start, func_end, inst->address + 4u)) {
+            u32 continuation = inst->address + 4u;
+            fprintf(out, "    {\n");
+            fprintf(out, "        u32 target = ctx->ctr & ~3u;\n");
+            emit_branch_condition(out, inst->bo, inst->bi);
+            fprintf(out, "        if (ctr_ok && cr_ok) {\n");
+            fprintf(out, "            ctx->lr = 0x%08Xu;\n", continuation);
+            fprintf(out, "            ctx->pc = target;\n");
+            fprintf(out, "            if (dolrecomp_call_enter()) {\n");
+            fprintf(out, "                int dolrecomp_indirect_call(CPUState* ctx, u32 address);\n");
+            fprintf(out, "                int handled = dolrecomp_indirect_call(ctx, target);\n");
+            fprintf(out, "                dolrecomp_call_leave();\n");
+            fprintf(out, "                if (!handled) { ctx->pc = target; return; }\n");
+            fprintf(out, "                if (ctx->pc == 0x%08Xu) goto label_%08X;\n",
+                    continuation, continuation);
+            fprintf(out, "            }\n");
+            fprintf(out, "            return;\n");
+            fprintf(out, "        }\n");
+            fprintf(out, "    }\n");
+            break;
+        }
         emit_dynamic_branch(out, inst, "ctx->ctr & ~3u", false, func_start);
         break;
 
@@ -1923,6 +1982,12 @@ bool emit_function(FILE* out, const PPCInst* insts, u32 count, u32 func_addr) {
     fprintf(out, "void func_%08X(CPUState* ctx) {\n", func_addr);
     fprintf(out, "    switch (ctx->pc) {\n");
     for (u32 i = 0; i < count; i++) {
+        // The first instruction after padding (embedded data) typically
