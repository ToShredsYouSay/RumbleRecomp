diff --git a/Source/Core/VideoCommon/VertexShaderManager.cpp b/Source/Core/VideoCommon/VertexShaderManager.cpp
index 6d69803..cfcd706 100644
--- a/Source/Core/VideoCommon/VertexShaderManager.cpp
+++ b/Source/Core/VideoCommon/VertexShaderManager.cpp
@@ -6,7 +6,10 @@
 #include <array>
 #include <cmath>
 #include <cstring>
+#include <cstdio>
+#include <cstdlib>
 #include <iterator>
+#include <set>
 
 #include "Common/ChunkFile.h"
 #include "Common/CommonTypes.h"
@@ -97,6 +100,58 @@ Common::Matrix44 VertexShaderManager::LoadProjectionMatrix()
     m_projection_matrix[14] = 0.0f;
     m_projection_matrix[15] = 1.0f;
 
+    // RumbleRecomp: the widescreen hack widens perspective (3D) projections by
+    // fAspectRatioHackW but leaves orthographic ones alone, so a 2D HUD authored for the
+    // game's native aspect gets stretched across a wider window. Compress full-screen 2D
+    // draws horizontally about the screen centre by the same factor, which restores their
+    // proportions and keeps screen-space elements attached to on-screen characters (the
+    // widened 3D view pulls off-centre objects inward by exactly that factor). Only
+    // draws into a full-width viewport qualify: off-screen passes (shadow/outline
+    // textures rendered into square viewports) must stay untouched. The factor tracks
+    // the window/custom aspect live, so fit-to-window resizing is covered too.
+    // Only horizontally centred projections (left == -right) qualify: NW4R layouts (the
+    // HUD) use those, while full-screen composites of off-screen passes (e.g. Pokémon
+    // Rumble's character outlines) use a 0..width projection and must keep covering the
+    // whole screen.
+    if (g_ActiveConfig.bWidescreenHack && g_ActiveConfig.bWidescreenHackHUDFix &&
+        std::abs(xfmem.viewport.wd * 2.0f) >= static_cast<float>(EFB_WIDTH) - 1.0f &&
+        std::abs(rawProjection[1]) < 1e-3f)
+    {
+      // Hor+ (window wider than the game): fAspectRatioHackW < 1. Vert+ (taller):
+      // fAspectRatioHackH < 1. Either way the HUD keeps its proportions and its size
+      // relative to the screen's limiting dimension, so it never shrinks or stretches.
+      m_projection_matrix[0] *= g_ActiveConfig.fAspectRatioHackW;
+      m_projection_matrix[3] *= g_ActiveConfig.fAspectRatioHackW;
+      m_projection_matrix[5] *= g_ActiveConfig.fAspectRatioHackH;
+      m_projection_matrix[7] *= g_ActiveConfig.fAspectRatioHackH;
+    }
+
+    // RumbleRecomp (temporary diagnostics): RR_LOG_ORTHO=1 prints each distinct
+    // orthographic projection once, with the viewport it is drawn into.
+    {
+      static const bool log_ortho = [] {
+        const char* v = std::getenv("RR_LOG_ORTHO");
+        return v && v[0] == '1';
+      }();
+      if (log_ortho)
+      {
+        static std::set<std::array<int, 6>> seen;
+        const std::array<int, 6> key{
+            static_cast<int>(rawProjection[0] * 1e6f), static_cast<int>(rawProjection[1] * 1e4f),
+            static_cast<int>(rawProjection[2] * 1e6f), static_cast<int>(rawProjection[3] * 1e4f),
+            static_cast<int>(xfmem.viewport.wd), static_cast<int>(xfmem.viewport.ht)};
+        if (seen.size() < 256 && seen.insert(key).second)
+        {
+          const float l = (-1.0f - rawProjection[1]) / rawProjection[0];
+          const float r = (1.0f - rawProjection[1]) / rawProjection[0];
+          const float b = (-1.0f - rawProjection[3]) / rawProjection[2];
+          const float t = (1.0f - rawProjection[3]) / rawProjection[2];
+          std::fprintf(stderr, "[ortho] l=%.2f r=%.2f t=%.2f b=%.2f viewport=%.1fx%.1f\n", l, r, t, b,
+                       xfmem.viewport.wd * 2.0f, -xfmem.viewport.ht * 2.0f);
+        }
+      }
+    }
+
     g_stats.g2proj = m_projection_matrix;
     g_stats.proj = rawProjection;
   }
