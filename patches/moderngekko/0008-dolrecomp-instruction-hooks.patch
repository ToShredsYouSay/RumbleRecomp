+// RumbleRecomp: native instruction hooks. DOLRECOMP_HOOKS="802A52F4:my_hook,..." emits a call
+// to `void my_hook(CPUState* ctx)` immediately before the guest instruction at that address,
+// every time it executes, whether reached by fallthrough, a local branch, a direct
+// cross-chunk call or the chassis. The hook sees (and may change) the full guest register
+// state at that point; its definition lives in a module source added with
+// RECOMPCORE_MODULE_EXTRA_SOURCES. Parsed lazily; at most 64 hooks.
+typedef struct {
+    u32 address;
+    char name[64];
+} InstructionHook;
+static InstructionHook g_hooks[64];
+static int g_hook_count = -1;
+
+static void load_instruction_hooks(void) {
+    g_hook_count = 0;
+    const char* spec = getenv("DOLRECOMP_HOOKS");
+    while (spec && *spec && g_hook_count < 64) {
+        char* end = NULL;
+        unsigned long addr = strtoul(spec, &end, 16);
+        if (!end || *end != ':')
+            break;
+        const char* name = end + 1;
+        size_t len = strcspn(name, ",");
+        if (len == 0 || len >= sizeof(g_hooks[0].name))
+            break;
+        g_hooks[g_hook_count].address = (u32)addr;
+        memcpy(g_hooks[g_hook_count].name, name, len);
+        g_hooks[g_hook_count].name[len] = '\0';
+        g_hook_count++;
+        spec = name + len;
+        if (*spec == ',')
+            spec++;
+    }
+}
+
+static void emit_instruction_hook(FILE* out, u32 address) {
+    if (g_hook_count < 0)
+        load_instruction_hooks();
+    for (int h = 0; h < g_hook_count; h++) {
+        if (g_hooks[h].address == address) {
+            fprintf(out, "    { void %s(CPUState* ctx); %s(ctx); }\n", g_hooks[h].name,
+                    g_hooks[h].name);
+        }
+    }
+}
+
 static bool address_is_branch_target(u32 addr) {
     u32 lo = 0, hi = g_entry_target_count;
     while (lo < hi) {
@@ -2010,6 +2059,7 @@ bool emit_function(FILE* out, const PPCInst* insts, u32 count, u32 func_addr) {
