+// RumbleRecomp: move saves between this runtime's emulated NAND and the Wii's own
+// save format (the data.bin a real Wii writes to SD via Data Management). Both run
+// without booting a game; they must not be called while a Runtime is active.
+// ImportWiiSave overwrites an existing save for the same title.
+std::optional<RuntimeError> ImportWiiSave(const std::filesystem::path& user_directory,
+                                          const std::filesystem::path& data_bin);
+// Writes <output_directory>/private/wii/title/<gamecode>/data.bin, the layout the Wii
+// expects on an SD card.
+std::optional<RuntimeError> ExportWiiSave(const std::filesystem::path& user_directory,
+                                          std::uint64_t title_id,
+                                          const std::filesystem::path& output_directory);
 }  // namespace moderngekko
 
