+namespace {
+const char *DescribeCopyResult(WiiSave::CopyResult result) {
+  switch (result) {
+  case WiiSave::CopyResult::Success: return "success";
+  case WiiSave::CopyResult::Cancelled: return "cancelled";
+  case WiiSave::CopyResult::CorruptedSource: return "the save file is corrupted or not a Wii save";
+  case WiiSave::CopyResult::TitleMissing: return "no save exists for that title";
+  default: return "the save could not be copied";
+  }
+}
+
+// Runs `op` with Dolphin's config and user paths set up for `user_directory`, outside a
+// Runtime (WiiSave builds its own IOS kernel over the NAND in that directory).
+template <typename Op>
+std::optional<RuntimeError> WithUserDirectory(const std::filesystem::path &user_directory,
+                                              Op &&op) {
+  if (s_runtime_active)
+    return RuntimeError{RuntimeErrorCode::AlreadyActive,
+                        "save transfer cannot run while the game is running"};
+  UICommon::SetUserDirectory(user_directory.string());
+  UICommon::Init();
+  std::optional<RuntimeError> error = op();
+  UICommon::Shutdown();
+  return error;
+}
+}  // namespace
+
+std::optional<RuntimeError> ImportWiiSave(const std::filesystem::path &user_directory,
+                                          const std::filesystem::path &data_bin) {
+  if (!std::filesystem::is_regular_file(data_bin))
+    return RuntimeError{RuntimeErrorCode::InvalidState,
+                        "save file not found: " + data_bin.string()};
+  // WiiSave::Import cannot create a title's data directory: on a Wii it exists from
+  // install time, but here it only appears on the game's first boot. Create it for
+  // every installed title (one with content/) that lacks one, so a save can be imported
+  // before the game is ever started.
+  std::error_code ec;
+  const auto titles = user_directory / "Wii" / "title";
+  for (const auto &kind : std::filesystem::directory_iterator(titles, ec)) {
+    for (const auto &title : std::filesystem::directory_iterator(kind.path(), ec)) {
+      if (std::filesystem::is_directory(title.path() / "content", ec))
+        std::filesystem::create_directories(title.path() / "data", ec);
+    }
+  }
+  return WithUserDirectory(user_directory, [&]() -> std::optional<RuntimeError> {
+    const auto result = WiiSave::Import(data_bin.string(), [] { return true; });
+    if (result != WiiSave::CopyResult::Success)
+      return RuntimeError{RuntimeErrorCode::InvalidState,
+                          std::string("save import failed: ") + DescribeCopyResult(result)};
+    return std::nullopt;
+  });
+}
+
+std::optional<RuntimeError> ExportWiiSave(const std::filesystem::path &user_directory,
+                                          std::uint64_t title_id,
+                                          const std::filesystem::path &output_directory) {
+  const char code[5] = {static_cast<char>(title_id >> 24), static_cast<char>(title_id >> 16),
+                        static_cast<char>(title_id >> 8), static_cast<char>(title_id), 0};
+  std::error_code ec;
+  std::filesystem::create_directories(output_directory / "private" / "wii" / "title" / code, ec);
+  return WithUserDirectory(user_directory, [&]() -> std::optional<RuntimeError> {
+    const auto result = WiiSave::Export(title_id, output_directory.string());
+    if (result != WiiSave::CopyResult::Success)
+      return RuntimeError{RuntimeErrorCode::InvalidState,
+                          std::string("save export failed: ") + DescribeCopyResult(result)};
+    return std::nullopt;
+  });
+}
