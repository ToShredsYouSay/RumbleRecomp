+void PostProcessing::BlitSidePanel(const MathUtil::Rectangle<int>& dst,
+                                   const MathUtil::Rectangle<int>& src,
+                                   const AbstractTexture* src_tex, bool left)
+{
+  const AbstractTextureFormat format = g_gfx->GetCurrentFramebuffer()->GetColorFormat();
+  if (!m_default_vertex_shader || format == AbstractTextureFormat::Undefined || dst.GetWidth() <= 0)
+    return;
+  const int side = left ? 0 : 1;
+  if (m_side_panel_format != format)
+  {
+    m_side_panel_pipeline[0].reset();
+    m_side_panel_pipeline[1].reset();
+    m_side_panel_format = format;
+  }
+  if (!m_side_panel_shader[side])
+  {
+    std::ostringstream ss;
+    ss << GetHeader(false);
+    ss << (left ? "#define RR_LEFT 1\n" : "#define RR_LEFT 0\n");
+    ss << R"(
+void main()
+{
+  float2 uv = v_tex0.xy;
+  // 0 at the edge that touches the picture, 1 at the outer window edge.
+  float t = clamp((uv.x - src_rect.x) / src_rect.z, 0.0, 1.0);
+  float outer = RR_LEFT != 0 ? (1.0 - t) : t;
+  // Wide box blur over the edge strip (7x7 taps) so the stretched strip reads as ambient
+  // colour, not a smeared copy of the picture.
+  // 11x11 taps: horizontally across the whole strip, vertically +-12% of the height, with a
+  // half-step stagger on alternate rows so sparse sampling does not show as horizontal bands.
+  float2 stp = float2(src_rect.z / 10.0, src_rect.w / 42.0);
+  float2 lo = src_rect.xy;
+  float2 hi = src_rect.xy + src_rect.zw;
+  float4 acc = float4(0.0, 0.0, 0.0, 0.0);
+  for (int j = -5; j <= 5; j++)
+  {
+    float stagger = (j % 2 == 0) ? 0.0 : 0.5;
+    for (int i = -5; i <= 5; i++)
+    {
+      float2 p = clamp(uv + float2(float(i) + stagger, float(j)) * stp, lo, hi);
+      acc += texture(samp0, float3(p, v_tex0.z));
+    }
+  }
+  acc = acc / 121.0;
+  float dim = mix(0.42, 0.06, smoothstep(0.0, 1.0, outer));
+  ocol0 = float4(acc.rgb * dim, 1.0);
+}
+)";
+    m_side_panel_shader[side] =
+        g_gfx->CreateShaderFromSource(ShaderStage::Pixel, ss.str(), nullptr,
+                                      left ? "Side panel pixel shader (left)" :
+                                             "Side panel pixel shader (right)");
+    if (!m_side_panel_shader[side])
+      return;
+  }
+  if (!m_side_panel_pipeline[side])
+  {
+    AbstractPipelineConfig config = {};
+    config.vertex_shader = m_default_vertex_shader.get();
+    config.geometry_shader = nullptr;
+    config.pixel_shader = m_side_panel_shader[side].get();
+    config.rasterization_state = RenderState::GetNoCullRasterizationState(PrimitiveType::Triangles);
+    config.depth_state = RenderState::GetNoDepthTestingDepthState();
+    config.blending_state = RenderState::GetNoBlendingBlendState();
+    config.framebuffer_state = RenderState::GetColorFramebufferState(format);
+    config.usage = AbstractPipelineUsage::Utility;
+    m_side_panel_pipeline[side] = g_gfx->CreatePipeline(config);
+    if (!m_side_panel_pipeline[side])
+      return;
+  }
+
+  g_gfx->SetSamplerState(0, RenderState::GetLinearSamplerState());
+  g_gfx->SetTexture(0, src_tex);
+  std::vector<u8> uniforms(CalculateUniformsSize(false));
+  FillUniformBuffer(src, src_tex, 0, dst, g_presenter->GetTargetRectangle(), uniforms.data(),
+                    false, false);
+  g_vertex_manager->UploadUtilityUniforms(uniforms.data(), static_cast<u32>(uniforms.size()));
+  g_gfx->SetViewportAndScissor(g_gfx->ConvertFramebufferRectangle(dst, g_gfx->GetCurrentFramebuffer()));
+  g_gfx->SetPipeline(m_side_panel_pipeline[side].get());
+  g_gfx->Draw(0, 3);
+}
