+
+void Install(std::filesystem::path state_directory, Platform* platform)
+{
+  // RR_MENU_COLOUR (set by the launcher) names the version's colour; otherwise guess from the folder.
+  const char* colour = std::getenv("RR_MENU_COLOUR");
+  std::string name = colour ? colour : state_directory.filename().string();
+  std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return std::tolower(c); });
+  if (name == "blue" || name.find("patch1") != std::string::npos)
+    SetTheme(BLUE);
+  else if (name == "red" || name.find("weekend") != std::string::npos)
+    SetTheme(RED);
+  else
+    SetTheme(GREEN);
+  s_dir = std::move(state_directory);
+  s_platform = platform;
+  VideoCommon::OnScreenUI::custom_init = AddFonts;
+  VideoCommon::OnScreenUI::custom_draw = Draw;
+  Platform::key_hook = [](int vk) {
+    if (vk != 0x1B && !g.open.load())
+      return false;
+    std::lock_guard lock(s_keys_mutex);
+    s_keys.push_back(vk);
+    return true;
+  };
+}
+
+void PushKey(int vk)
+{
+  std::lock_guard lock(s_keys_mutex);
+  s_keys.push_back(vk);
+}
+
+void Start()
+{
+  s_thread = std::jthread(Loop);
+}
+
+void Stop()
+{
+  s_thread.request_stop();
+  if (s_thread.joinable())
+    s_thread.join();
+  Platform::key_hook = nullptr;
+  VideoCommon::OnScreenUI::custom_draw = nullptr;
+  g.open = false;
+  // The video backend is gone by now: let go of the thumbnail textures without destroying them.
+  std::lock_guard lock(g.mutex);
+  for (Slot& slot : g.slots)
+    (void)slot.texture.release();
+  VideoCommon::OnScreenUI::linear_textures.clear();
+}
