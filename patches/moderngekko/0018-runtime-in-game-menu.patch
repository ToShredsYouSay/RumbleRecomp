+using Clock = std::chrono::steady_clock;
+
+constexpr int SLOTS = 4;
+constexpr u32 THUMB_WIDTH = 480;
+
+enum class Page
+{
+  Main,
+  Save,
+  Load,
+};
+enum MainItem
+{
+  ITEM_RESUME,
+  ITEM_SAVE,
+  ITEM_LOAD,
+  ITEM_FULLSCREEN,
+  ITEM_QUIT,
+  ITEM_COUNT,
+};
+
+struct Image
+{
+  std::vector<u8> rgba;
+  u32 width = 0;
+  u32 height = 0;
+};
+
+struct Slot
+{
+  bool exists = false;
+  std::string when;
+  Image thumb;
+  bool dirty = false;  // thumb changed, the video thread re-uploads it
+  std::unique_ptr<AbstractTexture> texture;
+};
+
+struct MenuState
+{
+  std::mutex mutex;
+  std::atomic<bool> open = false;
+  Page page = Page::Main;
+  int item = ITEM_RESUME;
+  int slot = 0;
+  std::array<Slot, SLOTS> slots;
+  Image frame;  // the game frame when the menu opened: the thumbnail for a new save
+  std::string toast;
+  Clock::time_point toast_until;
+  bool fullscreen = false;
+};
+
+MenuState g;
+std::filesystem::path s_dir;
+Platform* s_platform = nullptr;
+std::jthread s_thread;
+std::atomic<bool> s_redraw_pending = false;
+std::mutex s_keys_mutex;
+std::deque<int> s_keys;  // virtual-key codes from the game window
+ImFont* s_font = nullptr;
+ImFont* s_font_bold = nullptr;
+
+std::filesystem::path SlotPath(int slot, const char* ext)
+{
+  return s_dir / ("slot" + std::to_string(slot + 1) + ext);
+}
+
+// ---- thumbnails --------------------------------------------------------------------------------
+
+Image Downscale(const std::vector<u8>& src, u32 sw, u32 sh, u32 tw, u32 th, bool bgra)
+{
+  Image out;
+  out.width = tw;
+  out.height = th;
+  out.rgba.resize(static_cast<size_t>(tw) * th * 4);
+  for (u32 y = 0; y < th; ++y)
+  {
+    const u32 y0 = y * sh / th, y1 = std::max(y0 + 1, (y + 1) * sh / th);
+    for (u32 x = 0; x < tw; ++x)
+    {
+      const u32 x0 = x * sw / tw, x1 = std::max(x0 + 1, (x + 1) * sw / tw);
+      u32 sum[3] = {};
+      for (u32 sy = y0; sy < y1; ++sy)
+      {
+        const u8* p = &src[(static_cast<size_t>(sy) * sw + x0) * 4];
+        for (u32 sx = x0; sx < x1; ++sx, p += 4)
+        {
+          sum[0] += p[0];
+          sum[1] += p[1];
+          sum[2] += p[2];
+        }
+      }
+      const u32 n = (y1 - y0) * (x1 - x0);
+      u8* d = &out.rgba[(static_cast<size_t>(y) * tw + x) * 4];
+      d[0] = static_cast<u8>(sum[bgra ? 2 : 0] / n);
+      d[1] = static_cast<u8>(sum[1] / n);
+      d[2] = static_cast<u8>(sum[bgra ? 0 : 2] / n);
+      d[3] = 255;
+    }
+  }
+  return out;
+}
+
+// Video thread: read the last game frame back and shrink it to a thumbnail with the shape it has on
+// screen (the frame buffer itself is not stored at the displayed aspect ratio).
+void CaptureFrame()
+{
+  const AbstractTexture* xfb = g_presenter ? g_presenter->GetXFBTexture() : nullptr;
+  if (!xfb || !g_gfx)
+    return;
+  const auto format = xfb->GetFormat();
+  if (format != AbstractTextureFormat::RGBA8 && format != AbstractTextureFormat::BGRA8)
+    return;
+  MathUtil::Rectangle<int> rect = g_presenter->GetXFBRect();
+  rect.right = std::min<int>(rect.right, xfb->GetWidth());
+  rect.bottom = std::min<int>(rect.bottom, xfb->GetHeight());
+  const int w = rect.GetWidth(), h = rect.GetHeight();
+  if (w <= 0 || h <= 0)
+    return;
+  const TextureConfig config(w, h, 1, 1, 1, format, 0, AbstractTextureType::Texture_2DArray);
+  auto staging = g_gfx->CreateStagingTexture(StagingTextureType::Readback, config);
+  if (!staging)
+    return;
+  staging->CopyFromTexture(xfb, rect, 0, 0, {0, 0, w, h});
+  staging->Flush();
+  std::vector<u8> pixels(static_cast<size_t>(w) * h * 4);
+  staging->ReadTexels({0, 0, w, h}, pixels.data(), w * 4);
+
+  const auto target = g_presenter->GetTargetRectangle();
+  float aspect = target.GetHeight() > 0 ?
+                     static_cast<float>(target.GetWidth()) / target.GetHeight() :
+                     16.0f / 9.0f;
+  aspect = std::clamp(aspect, 1.0f, 4.0f);
+  const u32 tw = THUMB_WIDTH, th = static_cast<u32>(std::lround(THUMB_WIDTH / aspect));
+  Image thumb = Downscale(pixels, w, h, tw, th, format == AbstractTextureFormat::BGRA8);
+  std::lock_guard lock(g.mutex);
+  g.frame = std::move(thumb);
+}
+
+std::string FormatTime(std::chrono::system_clock::time_point when)
+{
+  const std::time_t t = std::chrono::system_clock::to_time_t(when);
+  std::tm tm{};
+#ifdef _WIN32
+  localtime_s(&tm, &t);
+#else
+  localtime_r(&t, &tm);
+#endif
+  char buf[64];
+  std::strftime(buf, sizeof(buf), "%d %b %Y, %H:%M", &tm);
+  std::string s = buf;
+  if (s.starts_with('0'))
+    s.erase(0, 1);
+  return s;
+}
+
+std::string FileTime(const std::filesystem::path& path)
+{
+  std::error_code ec;
+  const auto ftime = std::filesystem::last_write_time(path, ec);
+  if (ec)
+    return {};
+  return FormatTime(std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+      ftime - std::filesystem::file_time_type::clock::now() + std::chrono::system_clock::now()));
+}
+
+// Thumbnails are stored raw next to each save: "RRTH", width, height (little-endian u32), RGBA.
+bool WriteThumb(const std::filesystem::path& path, const Image& image)
+{
+  std::string data = "RRTH";
+  for (const u32 v : {image.width, image.height})
+    data.append(reinterpret_cast<const char*>(&v), 4);
+  data.append(reinterpret_cast<const char*>(image.rgba.data()), image.rgba.size());
+  return File::WriteStringToFile(path.string(), data);
+}
+
+bool ReadThumb(const std::filesystem::path& path, Image* image)
+{
+  std::string data;
+  if (!File::ReadFileToString(path.string(), data) || data.size() < 12 || !data.starts_with("RRTH"))
+    return false;
+  std::memcpy(&image->width, data.data() + 4, 4);
+  std::memcpy(&image->height, data.data() + 8, 4);
+  const size_t size = static_cast<size_t>(image->width) * image->height * 4;
+  if (image->width == 0 || image->height == 0 || image->width > 4096 || image->height > 4096 ||
+      data.size() != 12 + size)
+    return false;
+  image->rgba.assign(data.begin() + 12, data.end());
+  return true;
+}
+
+// Menu thread: read what is on disk for each slot.
+void RefreshSlots()
+{
+  for (int i = 0; i < SLOTS; ++i)
+  {
+    std::error_code ec;
+    const bool exists = std::filesystem::exists(SlotPath(i, ".sav"), ec);
+    Image thumb;
+    if (exists && !ReadThumb(SlotPath(i, ".thumb"), &thumb))
+      thumb = {};
+    std::lock_guard lock(g.mutex);
+    Slot& slot = g.slots[i];
+    slot.exists = exists;
+    slot.when = exists ? FileTime(SlotPath(i, ".sav")) : std::string();
+    slot.thumb = std::move(thumb);
+    slot.dirty = true;
+  }
+}
+
+// ---- drawing (video thread) --------------------------------------------------------------------
+
+// Colours follow the version being played, as in the launcher's tabs (tools/launcher.pyw TABS):
+// window body, panel, accent, and light accent.
+struct Theme
+{
+  u32 bg, panel, accent, light;
+};
+constexpr Theme GREEN{0x10251a, 0x173623, 0x1f8a45, 0x2fa85a};
+constexpr Theme RED{0x2a1012, 0x3e181b, 0xc42626, 0xe0483f};
+constexpr Theme BLUE{0x0f1a33, 0x172a50, 0x1e56c4, 0x3f78e6};
+
+ImU32 Rgb(u32 rgb, u32 alpha = 255)
+{
+  return IM_COL32((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF, alpha);
+}
+
+// Mixes rgb toward white by f (0..1).
+u32 Lighten(u32 rgb, float f)
+{
+  u32 out = 0;
+  for (int shift = 16; shift >= 0; shift -= 8)
+  {
+    const float c = static_cast<float>((rgb >> shift) & 0xFF);
+    out |= static_cast<u32>(c + (255.0f - c) * f) << shift;
+  }
+  return out;
+}
+
+ImU32 DIM, PANEL, PANEL_EDGE, ACCENT, ACCENT_LIGHT, CARD, CARD_HOVER, EMPTY;
+constexpr ImU32 TEXT = IM_COL32(244, 246, 250, 255);
+constexpr ImU32 MUTED = IM_COL32(185, 192, 204, 255);
+constexpr ImU32 FAINT = IM_COL32(130, 138, 152, 255);
+
+void SetTheme(const Theme& th)
+{
+  DIM = Rgb(th.bg, 180);
+  PANEL = Rgb(th.panel, 246);
+  PANEL_EDGE = Rgb(th.light, 200);
+  ACCENT = Rgb(th.accent);
+  ACCENT_LIGHT = Rgb(th.light);
+  CARD = Rgb(Lighten(th.panel, 0.05f));
+  CARD_HOVER = Rgb(Lighten(th.panel, 0.12f));
+  EMPTY = Rgb(th.bg);
+}
+
+ImU32 Fade(ImU32 col, float a)
+{
+  const u32 alpha = static_cast<u32>(((col >> IM_COL32_A_SHIFT) & 0xFF) * a);
+  return (col & ~IM_COL32_A_MASK) | (alpha << IM_COL32_A_SHIFT);
+}
+
+ImFont* Font(bool bold)
+{
+  ImFont* f = bold ? s_font_bold : s_font;
+  return f ? f : ImGui::GetFont();
+}
+
+ImVec2 Measure(bool bold, float size, const char* text)
+{
+  return Font(bold)->CalcTextSizeA(size, FLT_MAX, 0.0f, text);
+}
+
+// Text whose capital letters are vertically centred on cy (so it lines up with badges and rows).
+void Text(ImDrawList* dl, bool bold, float size, float x, float cy, ImU32 col, const char* text)
+{
+  const ImFontGlyph* cap = Font(bold)->GetFontBaked(size)->FindGlyph(static_cast<ImWchar>('H'));
+  const float mid = cap ? (cap->Y0 + cap->Y1) * 0.5f : size * 0.5f;
+  dl->AddText(Font(bold), size, ImVec2(std::round(x), std::round(cy - mid)), col, text);
+}
+
+// Draws text so that its drawn shape (not the font's line box) is centred on (cx, cy): horizontally by
+// the ink of the first and last glyphs, vertically by the ink of the first glyph (a capital, or the
+// single symbol of a badge).
+void TextCentred(ImDrawList* dl, bool bold, float size, float cx, float cy, ImU32 col, const char* text)
+{
+  ImFont* font = Font(bold);
+  ImFontBaked* baked = font->GetFontBaked(size);
+  const size_t n = std::strlen(text);
+  const ImFontGlyph* first = n ? baked->FindGlyph(static_cast<ImWchar>(text[0])) : nullptr;
+  const ImFontGlyph* last = n ? baked->FindGlyph(static_cast<ImWchar>(text[n - 1])) : nullptr;
+  if (!first || !last)
+    return;
+  const float width = font->CalcTextSizeA(size, FLT_MAX, 0.0f, text).x;
+  const float ink_left = first->X0;
+  const float ink_right = width - last->AdvanceX + last->X1;
+  const float x = cx - (ink_left + ink_right) * 0.5f;
+  const float y = cy - (first->Y0 + first->Y1) * 0.5f;
+  dl->AddText(font, size, ImVec2(std::round(x), std::round(y)), col, text);
+}
+
+// A round button badge with the letter the game shows in its prompts (as in the launcher pictures).
+float Badge(ImDrawList* dl, float x, float cy, float u, const char* letter)
+{
+  const float r = 15 * u;
+  dl->AddCircle(ImVec2(x + r, cy), r, MUTED, 0, 2 * u);
+  TextCentred(dl, true, 18 * u, x + r, cy, TEXT, letter);
+  return x + 2 * r;
+}
+
+// A keyboard key cap with its name, the same height as a badge.
+float Key(ImDrawList* dl, float x, float cy, float u, const char* name)
+{
+  const float h = 30 * u, size = 17 * u;
+  const float w = std::max(h, Measure(true, size, name).x + 20 * u);
+  dl->AddRect(ImVec2(x, cy - h * 0.5f), ImVec2(x + w, cy + h * 0.5f), MUTED, 7 * u, 0, 2 * u);
+  TextCentred(dl, true, size, x + w * 0.5f, cy, TEXT, name);
+  return x + w;
+}
+
+// One hint: controller badge, keyboard key, then what it does.
+float Hint(ImDrawList* dl, float x, float cy, float u, const char* letter, const char* key,
+           const char* label)
+{
+  x = Badge(dl, x, cy, u, letter) + 8 * u;
+  x = Key(dl, x, cy, u, key) + 12 * u;
+  Text(dl, false, 24 * u, x, cy, MUTED, label);
+  return x + Measure(false, 24 * u, label).x + 36 * u;
+}
+
+void Hints(ImDrawList* dl, float x, float cy, float u, const char* select)
+{
+  x = Hint(dl, x, cy, u, "A", "Enter", select);
+  Hint(dl, x, cy, u, "B", "Esc", "Back");
+}
+
+void UploadThumbnails()
+{
+  for (Slot& slot : g.slots)
+  {
+    if (!slot.dirty)
+      continue;
+    slot.dirty = false;
+    if (slot.texture)
+      VideoCommon::OnScreenUI::linear_textures.erase(slot.texture.get());
+    slot.texture.reset();
+    if (slot.thumb.rgba.empty())
+      continue;
+    const TextureConfig config(slot.thumb.width, slot.thumb.height, 1, 1, 1,
+                               AbstractTextureFormat::RGBA8, 0,
+                               AbstractTextureType::Texture_2DArray);
+    slot.texture = g_gfx->CreateTexture(config, "Menu thumbnail");
+    if (!slot.texture)
+      continue;
+    slot.texture->Load(0, slot.thumb.width, slot.thumb.height, slot.thumb.width,
+                       slot.thumb.rgba.data(), slot.thumb.rgba.size());
+    VideoCommon::OnScreenUI::linear_textures.insert(slot.texture.get());
+  }
+}
+
+void DrawMain(ImDrawList* dl, ImVec2 ds, float u)
+{
+  static const char* const labels[ITEM_COUNT] = {"Resume", "Save state", "Load state",
+                                                 "Fullscreen", "Quit game"};
+  const float pad = 36 * u, row = 66 * u, gap = 6 * u;
+  const float w = 600 * u;
+  constexpr float items = ITEM_COUNT;
+  const float h = pad + 56 * u + 26 * u + items * row + (items - 1) * gap + 34 * u +
+                  34 * u + pad;
+  const ImVec2 p0(std::round((ds.x - w) * 0.5f), std::round((ds.y - h) * 0.5f));
+  dl->AddRectFilled(p0, ImVec2(p0.x + w, p0.y + h), PANEL, 20 * u);
+  dl->AddRect(p0, ImVec2(p0.x + w, p0.y + h), PANEL_EDGE, 20 * u, 0, 2 * u);
+  Text(dl, true, 48 * u, p0.x + pad, p0.y + pad + 26 * u, TEXT, "Paused");
+  float y = p0.y + pad + 56 * u + 26 * u;
+  for (int i = 0; i < ITEM_COUNT; ++i)
+  {
+    const bool sel = g.item == i;
+    const ImVec2 r0(p0.x + pad - 14 * u, y), r1(p0.x + w - pad + 14 * u, y + row);
+    if (sel)
+      dl->AddRectFilled(r0, r1, ACCENT, 12 * u);
+    Text(dl, sel, 30 * u, p0.x + pad + 6 * u, y + row * 0.5f, TEXT, labels[i]);
+    if (i == static_cast<int>(ITEM_FULLSCREEN))
+    {
+      const char* value = g.fullscreen ? "On" : "Off";
+      const ImVec2 m = Measure(true, 26 * u, value);
+      Text(dl, true, 26 * u, r1.x - 22 * u - m.x, y + row * 0.5f, sel ? TEXT : MUTED, value);
+    }
+    y += row + gap;
+  }
+  Hints(dl, p0.x + pad, p0.y + h - pad - 17 * u, u, "Select");
+}
+
+void DrawSlots(ImDrawList* dl, ImVec2 ds, float u)
+{
+  const bool saving = g.page == Page::Save;
+  const float pad = 40 * u, gap = 24 * u, margin = 12 * u;
+  const float w = std::min(ds.x * 0.92f, 1560 * u);
+  const float card_w = (w - 2 * pad - (SLOTS - 1) * gap) / SLOTS;
+  const float thumb_h = (card_w - 2 * margin) * 9.0f / 16.0f;
+  const float card_h = margin + thumb_h + 16 * u + 30 * u + 8 * u + 24 * u + 18 * u;
+  const float h = pad + 50 * u + 16 * u + 26 * u + 30 * u + card_h + 34 * u + 34 * u + pad;
+  const ImVec2 p0(std::round((ds.x - w) * 0.5f), std::round((ds.y - h) * 0.5f));
+  dl->AddRectFilled(p0, ImVec2(p0.x + w, p0.y + h), PANEL, 20 * u);
+  dl->AddRect(p0, ImVec2(p0.x + w, p0.y + h), PANEL_EDGE, 20 * u, 0, 2 * u);
+  Text(dl, true, 44 * u, p0.x + pad, p0.y + pad + 25 * u, TEXT, saving ? "Save state" : "Load state");
+  Text(dl, false, 24 * u, p0.x + pad, p0.y + pad + 50 * u + 16 * u + 13 * u, MUTED,
+       saving ? "Choose a slot to save to. Saving replaces what is in it." :
+                "Choose a slot to load. Progress since you saved it is lost.");
+  const float top = p0.y + pad + 50 * u + 16 * u + 26 * u + 30 * u;
+  for (int i = 0; i < SLOTS; ++i)
+  {
+    const Slot& slot = g.slots[i];
+    const bool sel = g.slot == i;
+    const float a = (!saving && !slot.exists) ? 0.45f : 1.0f;
+    const ImVec2 c0(p0.x + pad + i * (card_w + gap), top), c1(c0.x + card_w, top + card_h);
+    dl->AddRectFilled(c0, c1, Fade(sel ? CARD_HOVER : CARD, a), 14 * u);
+    if (sel)
+      dl->AddRect(c0, c1, ACCENT_LIGHT, 14 * u, 0, 4 * u);
+    const ImVec2 t0(c0.x + margin, c0.y + margin), t1(c1.x - margin, t0.y + thumb_h);
+    dl->AddRectFilled(t0, t1, Fade(EMPTY, a), 8 * u);
+    if (slot.texture)
+    {
+      // fit the picture into the 16:9 box, keeping its own shape
+      const float tw = t1.x - t0.x, th = t1.y - t0.y;
+      const float img = static_cast<float>(slot.thumb.width) / slot.thumb.height;
+      float iw = tw, ih = tw / img;
+      if (ih > th)
+      {
+        ih = th;
+        iw = th * img;
+      }
+      const ImVec2 i0(t0.x + (tw - iw) * 0.5f, t0.y + (th - ih) * 0.5f);
+      dl->AddImageRounded(*slot.texture, i0, ImVec2(i0.x + iw, i0.y + ih), ImVec2(0, 0),
+                          ImVec2(1, 1), IM_COL32_WHITE, 8 * u);
+    }
+    else
+    {
+      TextCentred(dl, false, 26 * u, (t0.x + t1.x) * 0.5f, (t0.y + t1.y) * 0.5f, Fade(FAINT, a),
+                  "Empty");
+    }
+    const std::string name = "Slot " + std::to_string(i + 1);
+    float y = t1.y + 16 * u + 15 * u;
+    Text(dl, true, 30 * u, t0.x, y, Fade(TEXT, a), name.c_str());
+    y += 15 * u + 8 * u + 12 * u;
+    Text(dl, false, 23 * u, t0.x, y, Fade(MUTED, a), slot.exists ? slot.when.c_str() : "No save yet");
+  }
+  Hints(dl, p0.x + pad, p0.y + h - pad - 17 * u, u, saving ? "Save here" : "Load");
+}
+
+void Draw()
+{
+  if (!g.open.load())
+    return;
+  std::lock_guard lock(g.mutex);
+  if (!g.open.load())
+    return;
+  UploadThumbnails();
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  const ImVec2 ds = ImGui::GetIO().DisplaySize;
+  const float u = std::min(ds.y / 1080.0f, ds.x / 1600.0f);
+  dl->AddRectFilled(ImVec2(0, 0), ds, DIM);
+  if (g.page == Page::Main)
+    DrawMain(dl, ds, u);
+  else
+    DrawSlots(dl, ds, u);
+  if (!g.toast.empty() && Clock::now() < g.toast_until)
+  {
+    const float size = 26 * u;
+    const ImVec2 m = Measure(true, size, g.toast.c_str());
+    const ImVec2 b0(std::round((ds.x - m.x) * 0.5f - 28 * u), std::round(ds.y - 140 * u));
+    const ImVec2 b1(b0.x + m.x + 56 * u, b0.y + 60 * u);
+    dl->AddRectFilled(b0, b1, ACCENT, 30 * u);
+    Text(dl, true, size, b0.x + 28 * u, b0.y + 30 * u, TEXT, g.toast.c_str());
+  }
+}
