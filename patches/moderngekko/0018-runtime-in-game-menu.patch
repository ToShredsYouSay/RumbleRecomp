+class Platform;
+
+// RumbleRecomp: in-game menu, opened with a controller's HOME (Guide) button, both sticks pressed in, the
+// touchpad click, or Escape. It pauses the
+// game and offers Resume, save state and load state slots with thumbnails, a fullscreen toggle and
+// Quit game.
+namespace moderngekko::menu
+{
+// Installs the drawing hooks. Call before the video backend starts (before booting).
+void Install(std::filesystem::path state_directory, Platform* platform);
+// Starts reading input once the game is running. Stop() ends it.
+void Start();
+void Stop();
+// Feeds a key to the menu as if pressed in the game window (Windows virtual-key code). Used by
+// automation, so tests need neither real key presses nor window focus.
+void PushKey(int vk);
+}  // namespace moderngekko::menu
