+// Nunito from RR_FONT_DIR (the launcher's bundled fonts, SIL Open Font License), else Windows' Segoe UI.
+void AddFonts()
+{
+  ImGuiIO& io = ImGui::GetIO();
+  if (const char* dir = std::getenv("RR_FONT_DIR"); dir && *dir)
+  {
+    const std::string nunito = std::string(dir) + "\\Nunito-";
+    if (File::Exists(nunito + "Regular.ttf") && File::Exists(nunito + "Bold.ttf"))
+    {
+      s_font = io.Fonts->AddFontFromFileTTF((nunito + "Regular.ttf").c_str(), 32.0f);
+      s_font_bold = io.Fonts->AddFontFromFileTTF((nunito + "Bold.ttf").c_str(), 32.0f);
+      if (s_font && s_font_bold)
+        return;
+    }
+  }
+  const char* windir = std::getenv("WINDIR");
+  const std::string fonts = std::string(windir ? windir : "C:\\Windows") + "\\Fonts\\";
+  if (File::Exists(fonts + "segoeui.ttf"))
+    s_font = io.Fonts->AddFontFromFileTTF((fonts + "segoeui.ttf").c_str(), 32.0f);
+  if (File::Exists(fonts + "seguisb.ttf"))
+    s_font_bold = io.Fonts->AddFontFromFileTTF((fonts + "seguisb.ttf").c_str(), 32.0f);
+  else if (File::Exists(fonts + "segoeuib.ttf"))
+    s_font_bold = io.Fonts->AddFontFromFileTTF((fonts + "segoeuib.ttf").c_str(), 32.0f);
+}
+
+// ---- input and actions (menu thread) -----------------------------------------------------------
+
+struct Pad
+{
+  bool home = false, up = false, down = false, left = false, right = false, confirm = false,
+       back = false;
+  bool Any() const { return home || up || down || left || right || confirm || back; }
+};
+
+// Every connected SDL controller counts, so any player can open the menu. HOME opens it, and so do both sticks
+// pressed in together, or the touchpad click on PlayStation controllers: Steam takes HOME for Big Picture when it
+// is running, and the game uses neither of the others.
+Pad ReadPads()
+{
+  Pad pad;
+  for (const std::string& name : g_controller_interface.GetAllDeviceStrings())
+  {
+    if (name.rfind("SDL/", 0) != 0)
+      continue;
+    ciface::Core::DeviceQualifier q;
+    q.FromString(name);
+    const auto device = g_controller_interface.FindDevice(q);
+    if (!device)
+      continue;
+    bool thumb_l = false, thumb_r = false;
+    for (const auto* input : device->Inputs())
+    {
+      const std::string n = input->GetName();
+      const bool on = input->GetState() > 0.5;
+      if (!on)
+        continue;
+      if (n == "Guide" || n == "Touchpad")
+        pad.home = true;
+      else if (n == "Thumb L")
+        thumb_l = true;
+      else if (n == "Thumb R")
+        thumb_r = true;
+      else if (n == "Pad N" || n == "Left Y+")
+        pad.up = true;
+      else if (n == "Pad S" || n == "Left Y-")
+        pad.down = true;
+      else if (n == "Pad W" || n == "Left X-")
+        pad.left = true;
+      else if (n == "Pad E" || n == "Left X+")
+        pad.right = true;
+      else if (n == "Button S")
+        pad.confirm = true;
+      else if (n == "Button E" || n == "Button W")
+        pad.back = true;
+    }
+    if (thumb_l && thumb_r)
+      pad.home = true;
+  }
+  return pad;
+}
+
+bool KeysHeld()
+{
+#ifdef _WIN32
+  for (const int vk : {VK_RETURN, VK_SPACE, VK_ESCAPE, VK_BACK, int{'J'}, int{'K'}, int{'L'}})
+    if (GetAsyncKeyState(vk) & 0x8000)
+      return true;
+#endif
+  return false;
+}
+
+void Toast(std::string text)
+{
+  g.toast = std::move(text);
+  g.toast_until = Clock::now() + std::chrono::milliseconds(2500);
+}
+
+void RequestRedraw()
+{
+  if (s_redraw_pending.exchange(true))
+    return;
+  AsyncRequests::GetInstance()->PushEvent([] {
+    s_redraw_pending = false;
+    if (g_presenter)
+      g_presenter->Present(nullptr);
+  });
+}
+
+bool s_resume_on_close = false;
+
+void Open()
+{
+  auto& system = Core::System::GetInstance();
+  const auto state = Core::GetState(system);
+  if (state != Core::State::Running && state != Core::State::Paused)
+    return;
+  s_resume_on_close = state == Core::State::Running;
+  if (s_resume_on_close)
+    Core::SetState(system, Core::State::Paused);
+  RefreshSlots();
+  {
+    std::lock_guard lock(g.mutex);
+    g.frame = {};
+    g.page = Page::Main;
+    g.item = ITEM_RESUME;
+    g.toast.clear();
+    g.fullscreen = s_platform && s_platform->IsWindowFullscreen();
+  }
+  AsyncRequests::GetInstance()->PushEvent([] { CaptureFrame(); });
+  g.open = true;
+  RequestRedraw();
+}
+
+// Waits for the buttons and keys used in the menu to be let go, so the game does not see them.
+void WaitForRelease()
+{
+  const auto until = Clock::now() + std::chrono::milliseconds(1500);
+  while (Clock::now() < until)
+  {
+    g_controller_interface.UpdateInput();
+    if (!ReadPads().Any() && !KeysHeld())
+      return;
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+}
+
+void Close(bool resume = true)
+{
+  g.open = false;
+  RequestRedraw();  // one last frame without the menu
+  WaitForRelease();
+  if (resume && s_resume_on_close)
+    Core::SetState(Core::System::GetInstance(), Core::State::Running);
+}
+
+void SaveSlot(int i)
+{
+  std::filesystem::create_directories(s_dir);
+  State::SaveAs(Core::System::GetInstance(), SlotPath(i, ".sav").string());
+  std::lock_guard lock(g.mutex);
+  Slot& slot = g.slots[i];
+  if (!g.frame.rgba.empty())
+  {
+    WriteThumb(SlotPath(i, ".thumb"), g.frame);
+    slot.thumb = g.frame;
+  }
+  slot.exists = true;
+  slot.when = FormatTime(std::chrono::system_clock::now());  // the file is written in the background
+  slot.dirty = true;
+  g.page = Page::Main;
+  Toast("Saved to slot " + std::to_string(i + 1));
+}
+
+enum class Action
+{
+  None,
+  Close,
+  Quit,
+  Save,
+  Load,
+};
+
+// Menu thread: the slot with the newest save, or 0.
+int NewestSlot()
+{
+  int best = 0;
+  std::filesystem::file_time_type best_time{};
+  for (int i = 0; i < SLOTS; ++i)
+  {
+    std::error_code ec;
+    const auto t = std::filesystem::last_write_time(SlotPath(i, ".sav"), ec);
+    if (!ec && t > best_time)
+    {
+      best = i;
+      best_time = t;
+    }
+  }
+  return best;
+}
+
+// Moves through the menu; returns what the menu thread must do outside the lock.
+Action Navigate(int dx, int dy, bool confirm, bool back, int* slot_out)
+{
+  const int newest = NewestSlot();
+  std::lock_guard lock(g.mutex);
+  if (g.page == Page::Main)
+  {
+    g.item = std::clamp(g.item + dy, 0, ITEM_COUNT - 1);
+    if (back)
+      return Action::Close;
+    if (!confirm)
+      return Action::None;
+    switch (g.item)
+    {
+    case ITEM_RESUME:
+      return Action::Close;
+    case ITEM_SAVE:
+    case ITEM_LOAD:
+      g.page = g.item == ITEM_SAVE ? Page::Save : Page::Load;
+      g.slot = g.page == Page::Load ? newest : 0;  // loading starts on the newest save
+      return Action::None;
+    case ITEM_FULLSCREEN:
+      if (s_platform)
+        s_platform->RequestToggleFullscreen();
+      g.fullscreen = !g.fullscreen;
+      return Action::None;
+    case ITEM_QUIT:
+      return Action::Quit;
+    }
+    return Action::None;
+  }
+  g.slot = std::clamp(g.slot + dx, 0, SLOTS - 1);
+  if (back)
+  {
+    g.page = Page::Main;
+    return Action::None;
+  }
+  if (!confirm)
+    return Action::None;
+  *slot_out = g.slot;
+  if (g.page == Page::Save)
+    return Action::Save;
+  return g.slots[g.slot].exists ? Action::Load : Action::None;
+}
+
+// Held directions repeat after a short delay, like a keyboard.
+struct Repeat
+{
+  bool held = false;
+  Clock::time_point next;
+  bool Step(bool on)
+  {
+    const auto now = Clock::now();
+    if (!on)
+    {
+      held = false;
+      return false;
+    }
+    if (!held)
+    {
+      held = true;
+      next = now + std::chrono::milliseconds(380);
+      return true;
+    }
+    if (now >= next)
+    {
+      next = now + std::chrono::milliseconds(120);
+      return true;
+    }
+    return false;
+  }
+};
+
+void Loop(std::stop_token stop)
+{
+  Pad last;
+  Repeat up, down, left, right;
+  auto next_redraw = Clock::now();
+  while (!stop.stop_requested())
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(8));
+    const auto core = Core::GetState(Core::System::GetInstance());
+    if (core != Core::State::Running && core != Core::State::Paused)
+      continue;
+    g_controller_interface.UpdateInput();
+    const bool focus = Host_RendererHasFocus();
+    const Pad pad = focus ? ReadPads() : Pad{};
+    std::deque<int> keys;
+    {
+      std::lock_guard lock(s_keys_mutex);
+      keys.swap(s_keys);
+    }
+
+    if (!g.open)
+    {
+      const bool esc = std::find(keys.begin(), keys.end(), 0x1B) != keys.end();
+      if ((pad.home && !last.home) || esc)
+      {
+        Open();
+        up = down = left = right = {};
+        // the button that opened the menu must not also act in it
+        last = pad;
+        last.confirm = last.back = true;
+        continue;
+      }
+      last = pad;
+      continue;
+    }
+
+    int dx = 0, dy = 0;
+    bool confirm = pad.confirm && !last.confirm;
+    bool back = pad.back && !last.back;
+    bool home = pad.home && !last.home;
+    dy += down.Step(pad.down) - up.Step(pad.up);
+    dx += right.Step(pad.right) - left.Step(pad.left);
+    for (const int vk : keys)
+    {
+      switch (vk)
+      {
+      case 0x26: case 'W': dy -= 1; break;            // up
+      case 0x28: case 'S': dy += 1; break;            // down
+      case 0x25: case 'A': dx -= 1; break;            // left
+      case 0x27: case 'D': dx += 1; break;            // right
+      case 0x0D: case 'J': confirm = true; break;     // Enter, J
+      case 0x08: case 'K': back = true; break;        // Backspace, K
+      case 0x1B: home = true; break;                  // Escape
+      }
+    }
+    last = pad;
+
+    if (home)
+    {
+      bool on_main;
+      {
+        std::lock_guard lock(g.mutex);
+        on_main = g.page == Page::Main;
+      }
+      if (on_main)
+      {
+        Close();
+        continue;
+      }
+      back = true;  // Escape or HOME on a slot page goes back first
+    }
+
+    int slot = 0;
+    const Action action = Navigate(dx, dy, confirm, back, &slot);
+    if (action == Action::Save)
+      SaveSlot(slot);
+    if (action == Action::Close)
+    {
+      Close();
+      continue;
+    }
+    if (action == Action::Quit)
+    {
+      Close(false);
+      if (s_platform)
+        s_platform->Stop();
+      continue;
+    }
+    if (action == Action::Load)
+    {
+      State::LoadAs(Core::System::GetInstance(), SlotPath(slot, ".sav").string());
+      Close();
+      continue;
+    }
+    const auto now = Clock::now();
+    if (now >= next_redraw)
+    {
+      RequestRedraw();
+      next_redraw = now + std::chrono::milliseconds(16);
+    }
+  }
+}
