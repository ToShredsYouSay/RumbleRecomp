+// RumbleRecomp: achievements (see rumble_achievements.hpp).
+//
+// The game keeps its progress in the current save slot (a 0x1360-byte block). Its address is found through
+// the game's save manager (pointer at 0x804B90D0: slot array pointer at +0x44, current slot at +4), and
+// stage and battle royale progress is a table of words inside it, found by the game itself the same way
+// (IsStageCleared, IncMapClearedNum):
+//
+//   slot + 0x18 + A * 0x640 + B * 0x140 + C * 0x28 + D * 4
+//
+// The top 10 bits of each word count how many times that entry has been started (not cleared: the count goes up
+// when a battle begins), bit 0 is set once the entry is open to play (the game opens the next rank when you win
+// the one before), bit 1 once it has been played. What A, B, C, and D stand for is noted beside the entries in
+// use, in the set files under tools/achievements.
+
+#include "rumble_achievements.hpp"
+
+#include "Common/CommonTypes.h"
+#include "Core/HW/Memmap.h"
+#include "Core/System.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <deque>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <sstream>
+
+namespace moderngekko::achievements
+{
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+constexpr u32 SAVE_MANAGER = 0x804B90D0;
+constexpr u32 SLOT_SIZE = 0x1360;
+constexpr u32 TABLE_START = 0x18;
+constexpr int CHECK_MS = 500;
+constexpr int TOAST_SECONDS = 5;
+
+enum class Op { Eq, Ne, Ge, Le, Gt, Lt, And };
+
+struct Term
+{
+  enum Kind { Count, Flag, Mem, Dex } kind = Mem;
+  u32 a = 0, b = 0, c = 0, d = 0;  // Count, Flag: the table entry
+  u32 size = 4, addr = 0;          // Mem
+  Op op = Op::Ge;
+  u32 value = 1;
+  std::vector<u16> list;  // Dex: the species (dex numbers)
+  u32 min = 1;            // Dex: how many of the list must hold
+  bool shiny = false;     // Dex: look for a shiny befriended, not the collection status
+  bool defeats = false;   // Dex: add up the times each was defeated (at least min in all)
+  bool alt = false;       // starts an alternative: the entry holds if any group of terms (split by "|") holds
+};
+
+struct Set
+{
+  std::string id, title;
+  bool enabled = true;
+};
+
+struct Entry
+{
+  Item item;
+  size_t set = 0;
+  std::vector<Term> terms;
+  int streak = 0;  // consecutive checks where every term held
+};
+
+std::mutex s_mutex;
+std::vector<Set> s_sets;
+std::vector<Entry> s_entries;
+std::filesystem::path s_unlock_path, s_sets_path, s_options_path;
+bool s_popups = true;
+std::deque<Item> s_pending;  // the front one is on screen once s_toast_active
+bool s_toast_active = false;
+Clock::time_point s_toast_start, s_last_check;
+
+bool Read(u32 addr, u32 size, u32* out)
+{
+  const u8* p = Core::System::GetInstance().GetMemory().GetPointerForRange(addr, size);
+  if (!p)
+    return false;
+  u32 v = 0;
+  for (u32 i = 0; i < size; ++i)
+    v = (v << 8) | p[i];
+  *out = v;
+  return true;
+}
+
+// The collection (what the game's Collection screen shows) is an array of 0x1C-byte records indexed by dex
+// number, owned by an object {array pointer, count, count, ...} that the game allocates once a save is loaded:
+//
+//   +0x00 status: 0 unseen, 1 seen, 2 defeated, 3 befriended
+//   +0x10 times defeated, +0x14 mask of normal forms befriended, +0x18 mask of shiny forms befriended
+//
+// The object lives on the heap, so it is found by looking for it in main memory (and kept while it stays valid).
+constexpr u32 MEM1_START = 0x80000000, MEM1_SIZE = 0x1800000, DEX_RECORD = 0x1C;
+u32 s_dex_object = 0;
+Clock::time_point s_dex_scan;
+
+bool DexObjectValid(u32 object, u32* array, u32* count, bool deep)
+{
+  u32 n2;
+  if (!Read(object, 4, array) || !Read(object + 4, 4, count) || !Read(object + 8, 4, &n2) || *count != n2 ||
+      *count < 400 || *count > 700 || *array < MEM1_START || *array + *count * DEX_RECORD > MEM1_START + MEM1_SIZE)
+    return false;
+  u32 w;
+  if (!Read(*array, 4, &w) || w != 0)
+    return false;
+  if (deep)
+    for (u32 i = 1; i < *count; ++i)
+      if (!Read(*array + i * DEX_RECORD, 4, &w) || w > 3)
+        return false;
+  return true;
+}
+
+bool DexArray(u32* array, u32* count)
+{
+  if (s_dex_object && DexObjectValid(s_dex_object, array, count, false))
+    return true;
+  s_dex_object = 0;
+  const auto now = Clock::now();
+  if (now - s_dex_scan < std::chrono::seconds(5))
+    return false;
+  s_dex_scan = now;
+  const u8* p = Core::System::GetInstance().GetMemory().GetPointerForRange(MEM1_START, MEM1_SIZE);
+  if (!p)
+    return false;
+  auto word = [p](u32 i) { return u32(p[i * 4]) << 24 | u32(p[i * 4 + 1]) << 16 | u32(p[i * 4 + 2]) << 8 | p[i * 4 + 3]; };
+  for (u32 i = 0; i + 3 < MEM1_SIZE / 4; ++i)
+  {
+    const u32 n = word(i + 1);
+    if (n < 400 || n > 700 || word(i + 2) != n)
+      continue;
+    const u32 object = MEM1_START + i * 4;
+    if (DexObjectValid(object, array, count, true))
+    {
+      s_dex_object = object;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool TableWord(const Term& t, u32* word)
+{
+  u32 manager, slots, current;
+  if (!Read(SAVE_MANAGER, 4, &manager) || manager < 0x80000000 || !Read(manager + 0x44, 4, &slots) ||
+      !Read(manager + 4, 1, &current) || current > 2)
+    return false;
+  const u32 index = TABLE_START + t.a * 0x640 + t.b * 0x140 + t.c * 0x28 + t.d * 4;
+  return Read(slots + current * SLOT_SIZE + index, 4, word);
+}
+
+bool Holds(const Term& t)
+{
+  u32 v;
+  if (t.kind == Term::Count)
+    return TableWord(t, &v) && (v >> 22) >= t.value;
+  if (t.kind == Term::Flag)
+    return TableWord(t, &v) && (v & t.value) != 0;
+  if (t.kind == Term::Dex)
+  {
+    u32 array, count, have = 0;
+    if (!DexArray(&array, &count))
+      return false;
+    for (const u16 id : t.list)
+    {
+      if (id >= count)
+        continue;
+      if (t.defeats)
+      {
+        if (Read(array + id * DEX_RECORD + 0x10, 4, &v))
+          have += v;
+        continue;
+      }
+      const bool ok = t.shiny ? Read(array + id * DEX_RECORD + 0x18, 4, &v) && v != 0 :
+                                Read(array + id * DEX_RECORD, 4, &v) && v >= t.value;
+      have += ok;
+    }
+    return have >= t.min;
+  }
+  if (!Read(t.addr, t.size, &v))
+    return false;
+  switch (t.op)
+  {
+  case Op::Eq: return v == t.value;
+  case Op::Ne: return v != t.value;
+  case Op::Ge: return v >= t.value;
+  case Op::Le: return v <= t.value;
+  case Op::Gt: return v > t.value;
+  case Op::Lt: return v < t.value;
+  case Op::And: return (v & t.value) != 0;
+  }
+  return false;
+}
+
+std::string Trim(const std::string& s)
+{
+  const size_t a = s.find_first_not_of(" \t\r\n"), b = s.find_last_not_of(" \t\r\n");
+  return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+}
+
+bool ParseTerm(const std::string& text, Term* t)
+{
+  std::istringstream in(text);
+  std::string kind;
+  in >> kind;
+  if (kind == "count" || kind == "flag")
+  {
+    std::string tok[5];
+    for (std::string& s : tok)
+      in >> s;
+    t->kind = kind == "count" ? Term::Count : Term::Flag;
+    t->a = std::strtoul(tok[0].c_str(), nullptr, 0);
+    t->b = std::strtoul(tok[1].c_str(), nullptr, 0);
+    t->c = std::strtoul(tok[2].c_str(), nullptr, 0);
+    t->d = std::strtoul(tok[3].c_str(), nullptr, 0);
+    t->value = tok[4].empty() ? 1 : std::strtoul(tok[4].c_str(), nullptr, 0);  // count: at least; flag: mask
+    return !tok[3].empty() && t->a < 3 && t->b < 5 && t->c < 8 && t->d < 10;
+  }
+  if (kind == "dex" || kind == "shiny" || kind == "defeats")
+  {
+    // dex LIST [LEVEL [MIN]]: at least MIN (all by default) of LIST ("10", "1-12,25") are at LEVEL (3, befriended)
+    // or more. shiny LIST [MIN]: at least MIN (1) of LIST have a shiny form befriended.
+    std::string list, a, b;
+    in >> list >> a >> b;
+    t->kind = Term::Dex;
+    t->shiny = kind == "shiny";
+    t->defeats = kind == "defeats";
+    std::istringstream items(list);
+    std::string item;
+    while (std::getline(items, item, ','))
+    {
+      const size_t dash = item.find('-');
+      const u32 lo = std::strtoul(item.c_str(), nullptr, 10);
+      const u32 hi = dash == std::string::npos ? lo : std::strtoul(item.c_str() + dash + 1, nullptr, 10);
+      if (lo == 0 || hi < lo || hi > 1023)
+        return false;
+      for (u32 i = lo; i <= hi; ++i)
+        t->list.push_back(static_cast<u16>(i));
+    }
+    if (t->list.empty())
+      return false;
+    if (t->shiny || t->defeats)
+      t->min = a.empty() ? 1 : std::strtoul(a.c_str(), nullptr, 0);
+    else
+    {
+      t->value = a.empty() ? 3 : std::strtoul(a.c_str(), nullptr, 0);
+      t->min = b.empty() ? static_cast<u32>(t->list.size()) : std::strtoul(b.c_str(), nullptr, 0);
+    }
+    return true;
+  }
+  if (kind == "mem8" || kind == "mem16" || kind == "mem32")
+  {
+    std::string addr, op, value;
+    in >> addr >> op >> value;
+    t->size = kind == "mem8" ? 1 : kind == "mem16" ? 2 : 4;
+    t->addr = std::strtoul(addr.c_str(), nullptr, 0);
+    t->value = std::strtoul(value.c_str(), nullptr, 0);
+    if (op == "==") t->op = Op::Eq;
+    else if (op == "!=") t->op = Op::Ne;
+    else if (op == ">=") t->op = Op::Ge;
+    else if (op == "<=") t->op = Op::Le;
+    else if (op == ">") t->op = Op::Gt;
+    else if (op == "<") t->op = Op::Lt;
+    else if (op == "&") t->op = Op::And;
+    else return false;
+    return !value.empty();
+  }
+  return false;
+}
+
+bool ParseCondition(const std::string& text, std::vector<Term>* terms)
+{
+  size_t start = 0;
+  bool first_of_group = false;
+  while (start <= text.size())
+  {
+    size_t end = text.find_first_of(";|", start);
+    const std::string part = Trim(text.substr(start, end == std::string::npos ? end : end - start));
+    Term t;
+    if (!ParseTerm(part, &t))
+      return false;
+    t.alt = first_of_group;
+    terms->push_back(t);
+    if (end == std::string::npos)
+      break;
+    first_of_group = text[end] == '|';
+    start = end + 1;
+  }
+  return !terms->empty();
+}
+
+// Reads one set file into s_sets and s_entries, unless it is for other versions.
+void LoadSet(const std::filesystem::path& file, const std::string& version,
+             const std::map<std::string, bool>& chosen)
+{
+  std::ifstream in(file);
+  if (!in)
+  {
+    std::fprintf(stderr, "[achievements] cannot open %s\n", file.string().c_str());
+    return;
+  }
+  Set set;
+  set.id = file.stem().string();
+  set.title = set.id;
+  bool on = true;
+  std::vector<std::string> versions;
+  std::vector<Entry> entries;
+  std::string line;
+  while (std::getline(in, line))
+  {
+    const std::string text = Trim(line);
+    if (text.empty() || text[0] == '#')
+      continue;
+    if (text[0] == '@')
+    {
+      std::istringstream row(text.substr(1));
+      std::string key;
+      row >> key;
+      const std::string rest = Trim(text.substr(std::min(text.size(), 1 + key.size())));
+      if (key == "title")
+        set.title = rest;
+      else if (key == "default")
+        on = rest != "off";
+      else if (key == "versions")
+        for (std::string v; row >> v;)
+          versions.push_back(v);
+      continue;
+    }
+    std::vector<std::string> field;
+    std::istringstream row(line);
+    for (std::string f; std::getline(row, f, '\t');)
+      field.push_back(Trim(f));
+    Entry e;
+    if ((field.size() != 4 && field.size() != 5) || !ParseCondition(field[3], &e.terms))
+    {
+      std::fprintf(stderr, "[achievements] skipped a bad line: %s\n", line.c_str());
+      continue;
+    }
+    e.item = {set.id + ":" + field[0], field[1], field[2], false, field.size() == 5 ? field[4] : std::string()};
+    entries.push_back(std::move(e));
+  }
+  if (!versions.empty() && std::find(versions.begin(), versions.end(), version) == versions.end())
+    return;
+  const auto it = chosen.find(set.id);
+  set.enabled = it != chosen.end() ? it->second : on;
+  for (Entry& e : entries)
+  {
+    e.set = s_sets.size();
+    s_entries.push_back(std::move(e));
+  }
+  s_sets.push_back(std::move(set));
+}
+
+void SaveChoices()
+{
+  std::filesystem::create_directories(s_sets_path.parent_path());
+  std::ofstream sets(s_sets_path, std::ios::trunc);
+  for (const Set& s : s_sets)
+    sets << s.id << ' ' << (s.enabled ? "on" : "off") << '\n';
+  std::ofstream options(s_options_path, std::ios::trunc);
+  options << "popups " << (s_popups ? "on" : "off") << '\n';
+}
+}  // namespace
+
+void Load(const std::filesystem::path& state_directory)
+{
+  const char* list = std::getenv("RR_ACHIEVEMENTS");
+  if (!list || !*list)
+    return;
+  std::lock_guard lock(s_mutex);
+  s_sets.clear();
+  s_entries.clear();
+  s_pending.clear();
+  s_unlock_path = state_directory / "achievements.txt";
+  s_sets_path = state_directory / "achievement_sets.txt";
+  s_options_path = state_directory.parent_path() / "achievement_options.txt";
+  const std::string version = state_directory.filename().string();
+
+  std::map<std::string, bool> chosen;
+  {
+    std::ifstream in(s_sets_path);
+    std::string id, state;
+    while (in >> id >> state)
+      chosen[id] = state != "off";
+  }
+  {
+    std::ifstream in(s_options_path);
+    std::string key, value;
+    while (in >> key >> value)
+      if (key == "popups")
+        s_popups = value != "off";
+  }
+
+  std::vector<std::filesystem::path> files;
+  std::error_code ec;
+  if (std::filesystem::is_directory(list, ec))
+  {
+    for (const auto& f : std::filesystem::directory_iterator(list, ec))
+      if (f.is_regular_file() && f.path().extension() == ".txt")
+        files.push_back(f.path());
+    std::sort(files.begin(), files.end());
+    std::stable_sort(files.begin(), files.end(), [](const auto& a, const auto& b) {
+      return (a.stem() == "main") > (b.stem() == "main");  // the main set comes first, the others by name
+    });
+  }
+  else
+  {
+    files.push_back(list);
+  }
+  for (const auto& f : files)
+    LoadSet(f, version, chosen);
+
+  std::ifstream saved(s_unlock_path);
+  int unlocked = 0;
+  for (std::string row; std::getline(saved, row);)
+  {
+    std::string id = row.substr(0, row.find('\t'));
+    if (id.find(':') == std::string::npos)
+      id = "main:" + id;  // unlocks saved before sets existed
+    for (Entry& e : s_entries)
+      if (e.item.id == id && !e.item.unlocked)
+      {
+        e.item.unlocked = true;
+        ++unlocked;
+      }
+  }
+  std::fprintf(stderr, "[achievements] %zu sets, %zu achievements, %d already unlocked\n", s_sets.size(),
+               s_entries.size(), unlocked);
+}
+
+void Tick()
+{
+  const auto now = Clock::now();
+  std::lock_guard lock(s_mutex);
+  if (s_entries.empty())
+    return;
+  if (s_toast_active && now - s_toast_start > std::chrono::seconds(TOAST_SECONDS))
+  {
+    s_pending.pop_front();
+    s_toast_active = false;
+  }
+  if (!s_toast_active && !s_pending.empty())
+  {
+    s_toast_active = true;
+    s_toast_start = now;
+  }
+  if (now - s_last_check < std::chrono::milliseconds(CHECK_MS))
+    return;
+  s_last_check = now;
+
+  // An entry unlocks once every term has held on two checks in a row, so a half-written value (a save
+  // being loaded, a scene changing) never counts.
+  std::vector<Entry*> fresh;
+  for (Entry& e : s_entries)
+  {
+    if (e.item.unlocked || !s_sets[e.set].enabled)
+      continue;
+    bool all = false, group = true;
+    for (const Term& t : e.terms)
+    {
+      if (t.alt)
+      {
+        all = all || group;
+        group = true;
+      }
+      group = group && Holds(t);
+    }
+    all = all || group;
+    e.streak = all ? e.streak + 1 : 0;
+    if (e.streak >= 2)
+      fresh.push_back(&e);
+  }
+  if (fresh.empty())
+    return;
+  std::filesystem::create_directories(s_unlock_path.parent_path());
+  std::ofstream saved(s_unlock_path, std::ios::app);
+  for (Entry* e : fresh)
+  {
+    e->item.unlocked = true;
+    saved << e->item.id << '\t' << std::time(nullptr) << '\n';
+  }
+  if (!s_popups)
+    return;
+  if (fresh.size() > 3)  // progress the game already had: one pop-up, not a queue of them
+    s_pending.push_back({"", std::to_string(fresh.size()) + " achievements unlocked",
+                         "From the progress already in your save", true, "trophy"});
+  else
+    for (Entry* e : fresh)
+      s_pending.push_back(e->item);
+}
+
+std::vector<Item> Snapshot()
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<Item> items;
+  for (const Entry& e : s_entries)
+    if (s_sets[e.set].enabled)
+      items.push_back(e.item);
+  return items;
+}
+
+std::vector<SetInfo> Sets()
+{
+  std::lock_guard lock(s_mutex);
+  std::vector<SetInfo> info;
+  for (const Set& s : s_sets)
+    info.push_back({s.title, s.enabled, 0, 0});
+  for (const Entry& e : s_entries)
+  {
+    ++info[e.set].total;
+    info[e.set].earned += e.item.unlocked ? 1 : 0;
+  }
+  return info;
+}
+
+void ToggleSet(size_t index)
+{
+  std::lock_guard lock(s_mutex);
+  if (index >= s_sets.size())
+    return;
+  s_sets[index].enabled = !s_sets[index].enabled;
+  for (Entry& e : s_entries)
+    e.streak = 0;
+  SaveChoices();
+}
+
+bool Popups()
+{
+  std::lock_guard lock(s_mutex);
+  return s_popups;
+}
+
+void TogglePopups()
+{
+  std::lock_guard lock(s_mutex);
+  s_popups = !s_popups;
+  if (!s_popups)
+  {
+    s_pending.clear();
+    s_toast_active = false;
+  }
+  SaveChoices();
+}
+
+void ResetAll()
+{
+  std::lock_guard lock(s_mutex);
+  for (Entry& e : s_entries)
+  {
+    e.item.unlocked = false;
+    e.streak = 0;
+  }
+  s_pending.clear();
+  s_toast_active = false;
+  std::error_code ec;
+  std::filesystem::remove(s_unlock_path, ec);
+}
+
+bool CurrentToast(Item* item, float* shown_for)
+{
+  std::lock_guard lock(s_mutex);
+  if (!s_popups || !s_toast_active || s_pending.empty())
+    return false;
+  *item = s_pending.front();
+  *shown_for = std::chrono::duration<float>(Clock::now() - s_toast_start).count();
+  return true;
+}
