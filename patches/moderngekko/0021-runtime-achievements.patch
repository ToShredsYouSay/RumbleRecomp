+// Badge colours for the icons: rank letters, special marks, and the 17 types the game uses.
+u32 BadgeColour(const std::string& name, const std::string& arg)
+{
+  struct Entry
+  {
+    const char* key;
+    u32 rgb;
+  };
+  static const Entry colours[] = {
+      {"C", 0xb5733c},        {"B", 0x8d99a6},        {"A", 0xe0a526},        {"S", 0xa855f7},
+      {"EX", 0xe5484d},       {"crown", 0xe0a526},    {"trophy", 0xe0a526},   {"star", 0xf0b429},
+      {"flame", 0xf0742a},    {"normal", 0x9ca3af},   {"fire", 0xef6a3a},     {"water", 0x3b8ee8},
+      {"electric", 0xe3b81a}, {"grass", 0x3fa650},    {"ice", 0x4cc3d9},      {"fighting", 0xc4572b},
+      {"poison", 0xa24bc2},   {"ground", 0xb08d4a},   {"flying", 0x7d92f0},   {"psychic", 0xec5f93},
+      {"bug", 0x8fbf2f},      {"rock", 0x9a8470},     {"ghost", 0x6f55b8},    {"dragon", 0x4a5bd0},
+      {"dark", 0x4f5f6b},     {"steel", 0x8da2b0}};
+  for (const Entry& e : colours)
+    if (arg == e.key || (arg.empty() && name == e.key))
+      return e.rgb;
+  return 0x2f8f57;
+}
