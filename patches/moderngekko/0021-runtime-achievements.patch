+// RumbleRecomp: achievements, our own. Conditions on the game's memory, checked while it runs; no network,
+// no account. RR_ACHIEVEMENTS (set by the launcher) names a folder of sets, one text file per set; a single
+// file works as one set (main.txt is listed first, the others by name). In a set file, lines starting with "@"
+// describe the set:
+//
+//   @title Main set              shown in the menu
+//   @default on                  whether it starts switched on (default on)
+//   @versions vanilla weekend    which versions it applies to (default all)
+//
+// and every other line (not blank, not starting with "#") is one achievement, fields separated by tabs:
+//
+//   id  title  description  condition  [icon]
+//
+// The icon is drawn by the menu: rank:C (also B, A, S, EX), crown (crown:C puts a letter on it), trophy, star,
+// flame, or type:grass (fire, water, electric, ice, fighting, poison, ground, flying, psychic, bug, rock, ghost,
+// dragon, dark, steel, normal).
+//
+// A condition is one or more terms separated by ";" (all must hold); "|" separates alternatives (any group holds):
+//   count A B C D [N]            the game's progress table (see rumble_achievements.cpp): start count >= N (1)
+//   flag A B C D MASK            the same table entry: any bit of MASK set (1 is open to play, 2 has been played)
+//   dex LIST [LEVEL [MIN]]       the Collection screen: at least MIN (all) of the species in LIST (dex numbers, as in
+//                                "10" or "1-12,25") are at LEVEL (3 befriended, 2 defeated, 1 seen) or more
+//   shiny LIST [MIN]             at least MIN (1) of the species in LIST have a shiny form befriended
+//   defeats LIST [MIN]           the species in LIST have been defeated MIN (1) times in all, added together
+//   mem8|mem16|mem32 ADDR OP V   a live value at a guest address; OP is == != >= <= > < or & (any bit of V)
+//
+// Beside the save states of each version the game keeps achievements.txt (unlocks, which are never taken back
+// except by a reset) and achievement_sets.txt (which sets are on); one folder up, achievement_options.txt holds
+// the pop-up setting for every version.
+#pragma once
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace moderngekko::achievements
+{
+struct Item
+{
+  std::string id, title, text;
+  bool unlocked = false;
+  std::string icon;
+};
+
+struct SetInfo
+{
+  std::string title;
+  bool enabled = true;
+  int earned = 0, total = 0;
+};
+
+// Reads the sets (RR_ACHIEVEMENTS), the choices, and the unlocks kept for this version. Does nothing if no
+// list is set.
+void Load(const std::filesystem::path& state_directory);
+
+// Checks the switched-on sets now and then (cheap to call every frame) and queues pop-ups for new unlocks.
+void Tick();
+
+// The achievements of the switched-on sets, with unlock states, for the menu page.
+std::vector<Item> Snapshot();
+
+std::vector<SetInfo> Sets();
+void ToggleSet(size_t index);
+bool Popups();
+void TogglePopups();
+
+// Forgets every unlock for this version. The game's own save is untouched, so a save that already has the
+// progress earns them again within a second; a new save earns them afresh.
+void ResetAll();
+
+// The pop-up to show right now, if any; shown_for is how long it has been on screen, in seconds.
+bool CurrentToast(Item* item, float* shown_for);
+}  // namespace moderngekko::achievements
