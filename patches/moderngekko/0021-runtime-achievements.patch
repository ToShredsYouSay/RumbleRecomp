+// A round check badge: filled when earned, an outline when not.
+void CheckBadge(ImDrawList* dl, ImVec2 c, float r, float u, bool done, float a = 1.0f)
+{
+  if (!done)
+  {
+    dl->AddCircle(c, r, Fade(FAINT, a), 0, 2.5f * u);
+    return;
+  }
+  dl->AddCircleFilled(c, r, Fade(ACCENT, a));
+  const ImVec2 pts[3] = {ImVec2(c.x - r * 0.42f, c.y + r * 0.02f), ImVec2(c.x - r * 0.1f, c.y + r * 0.34f),
+                         ImVec2(c.x + r * 0.46f, c.y - r * 0.32f)};
+  dl->AddPolyline(pts, 3, Fade(TEXT, a), 0, std::max(2.0f, r * 0.17f));
+}
+
+void DrawAchievements(ImDrawList* dl, ImVec2 ds, float u)
+{
+  const std::vector<achievements::Item> items = achievements::Snapshot();
+  const int total = static_cast<int>(items.size());
+  int earned = 0;
+  for (const auto& item : items)
+    earned += item.unlocked ? 1 : 0;
+  const float pad = 40 * u, row = 78 * u;
+  const float w = std::min(ds.x * 0.92f, 1100 * u);
+  const float h = pad + 50 * u + 16 * u + 26 * u + 24 * u + ACH_ROWS * row + 20 * u + 34 * u + pad;
+  const ImVec2 p0(std::round((ds.x - w) * 0.5f), std::round((ds.y - h) * 0.5f));
+  dl->AddRectFilled(p0, ImVec2(p0.x + w, p0.y + h), PANEL, 20 * u);
+  dl->AddRect(p0, ImVec2(p0.x + w, p0.y + h), PANEL_EDGE, 20 * u, 0, 2 * u);
+  Text(dl, true, 44 * u, p0.x + pad, p0.y + pad + 25 * u, TEXT, "Achievements");
+  if (total)
+  {
+    const std::string count = std::to_string(earned) + " of " + std::to_string(total);
+    Text(dl, true, 30 * u, p0.x + w - pad - Measure(true, 30 * u, count.c_str()).x, p0.y + pad + 25 * u,
+         MUTED, count.c_str());
+  }
+  Text(dl, false, 24 * u, p0.x + pad, p0.y + pad + 50 * u + 16 * u + 13 * u, MUTED,
+       total ? "Earned by playing. Up and down scroll, left and right turn the page." : "There are no achievements for this version yet.");
+  const float top = p0.y + pad + 50 * u + 16 * u + 26 * u + 24 * u;
+  for (int i = 0; i < ACH_ROWS && g.scroll + i < total; ++i)
+  {
+    const achievements::Item& item = items[g.scroll + i];
+    const float y = top + i * row;
+    dl->AddRectFilled(ImVec2(p0.x + pad - 14 * u, y), ImVec2(p0.x + w - pad + 14 * u, y + row - 8 * u), CARD,
+                      12 * u);
+    const ImVec2 ic(p0.x + pad + 26 * u, y + (row - 8 * u) * 0.5f);
+    DrawIcon(dl, ic, 26 * u, item.icon.empty() ? "star" : item.icon, item.unlocked);
+    if (item.unlocked)
+      CheckBadge(dl, ImVec2(ic.x + 18 * u, ic.y + 18 * u), 10 * u, u, true);
+    const float x = p0.x + pad + 70 * u;
+    Text(dl, true, 28 * u, x, y + 24 * u, item.unlocked ? TEXT : MUTED, item.title.c_str());
+    Text(dl, false, 22 * u, x, y + 52 * u, item.unlocked ? MUTED : FAINT, item.text.c_str());
+  }
+  if (total > ACH_ROWS)  // where the visible rows sit in the list
+  {
+    const float track = ACH_ROWS * row - 8 * u, x = p0.x + w - pad + 30 * u;
+    const float thumb = std::max(40 * u, track * ACH_ROWS / total);
+    const float at = (track - thumb) * g.scroll / std::max(1, total - ACH_ROWS);
+    dl->AddRectFilled(ImVec2(x, top), ImVec2(x + 6 * u, top + track), CARD, 3 * u);
+    dl->AddRectFilled(ImVec2(x, top + at), ImVec2(x + 6 * u, top + at + thumb), ACCENT_LIGHT, 3 * u);
+  }
+  Hints(dl, p0.x + pad, p0.y + h - pad - 17 * u, u, "Options");
+}
+
+// Sets on and off, pop-ups on and off, and the way into the reset.
+void DrawAchOptions(ImDrawList* dl, ImVec2 ds, float u)
+{
+  const std::vector<achievements::SetInfo> sets = achievements::Sets();
+  const int rows = static_cast<int>(sets.size()) + 2;
+  const float pad = 36 * u, row = 66 * u, gap = 6 * u, w = 760 * u;
+  const float h = pad + 56 * u + 26 * u + rows * row + (rows - 1) * gap + 34 * u + 34 * u + pad;
+  const ImVec2 p0(std::round((ds.x - w) * 0.5f), std::round((ds.y - h) * 0.5f));
+  dl->AddRectFilled(p0, ImVec2(p0.x + w, p0.y + h), PANEL, 20 * u);
+  dl->AddRect(p0, ImVec2(p0.x + w, p0.y + h), PANEL_EDGE, 20 * u, 0, 2 * u);
+  Text(dl, true, 48 * u, p0.x + pad, p0.y + pad + 26 * u, TEXT, "Achievement options");
+  float y = p0.y + pad + 56 * u + 26 * u;
+  for (int i = 0; i < rows; ++i)
+  {
+    const bool sel = g.option == i;
+    const int n = static_cast<int>(sets.size());
+    const std::string label = i < n ? sets[i].title : (i == n ? "Pop-ups" : "Reset achievements");
+    std::string value = i < n ? std::string(sets[i].enabled ? "On" : "Off") + "   " + std::to_string(sets[i].earned) + " of " +
+                                    std::to_string(sets[i].total) :
+                                (i == n ? (achievements::Popups() ? "On" : "Off") : "");
+    const ImVec2 r0(p0.x + pad - 14 * u, y), r1(p0.x + w - pad + 14 * u, y + row);
+    if (sel)
+      dl->AddRectFilled(r0, r1, ACCENT, 12 * u);
+    Text(dl, sel, 30 * u, p0.x + pad + 6 * u, y + row * 0.5f, TEXT, label.c_str());
+    const ImVec2 m = Measure(true, 26 * u, value.c_str());
+    Text(dl, true, 26 * u, r1.x - 22 * u - m.x, y + row * 0.5f, sel ? TEXT : MUTED, value.c_str());
+    y += row + gap;
+  }
+  Hints(dl, p0.x + pad, p0.y + h - pad - 17 * u, u, "Select");
+}
+
+// "Are you sure?", answered No unless you move to Yes.
+void DrawResetAsk(ImDrawList* dl, ImVec2 ds, float u)
+{
+  const float pad = 40 * u, w = 820 * u, button = 70 * u, gap = 20 * u;
+  const float h = pad + 50 * u + 22 * u + 30 * u + 18 * u + 30 * u + 30 * u + 26 * u + button + 30 * u + 34 * u + pad;
+  const ImVec2 p0(std::round((ds.x - w) * 0.5f), std::round((ds.y - h) * 0.5f));
+  dl->AddRectFilled(p0, ImVec2(p0.x + w, p0.y + h), PANEL, 20 * u);
+  dl->AddRect(p0, ImVec2(p0.x + w, p0.y + h), PANEL_EDGE, 20 * u, 0, 2 * u);
+  float y = p0.y + pad;
+  Text(dl, true, 44 * u, p0.x + pad, y + 25 * u, TEXT, "Reset achievements");
+  y += 50 * u + 22 * u;
+  Text(dl, true, 30 * u, p0.x + pad, y + 15 * u, TEXT, "Are you sure you want to reset your achievements?");
+  y += 30 * u + 18 * u;
+  Text(dl, false, 24 * u, p0.x + pad, y + 12 * u, MUTED, "Achievements come from the progress in your save.");
+  y += 30 * u;
+  Text(dl, false, 24 * u, p0.x + pad, y + 12 * u, MUTED, "A save that already has them earns them back right away.");
+  y += 30 * u + 26 * u;
+  const float bw = (w - 2 * pad - gap) * 0.5f;
+  for (int i = 0; i < 2; ++i)  // No first, then Yes
+  {
+    const bool yes = i == 1, sel = g.ask_yes == yes;
