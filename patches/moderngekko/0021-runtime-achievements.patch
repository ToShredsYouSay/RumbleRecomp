+// An achievement icon: a coloured disc with a white shape when earned, a dim disc with a grey one when not.
+// spec is "rank:C", "crown", "crown:A", "trophy", "star", "flame", or "type:<name>" (see the achievements header).
+void DrawIcon(ImDrawList* dl, ImVec2 c, float r, const std::string& spec, bool earned, float a = 1.0f)
+{
+  const size_t colon = spec.find(':');
+  const std::string name = spec.substr(0, colon);
+  const std::string arg = colon == std::string::npos ? std::string() : spec.substr(colon + 1);
+  const u32 rgb = BadgeColour(name, arg);
+  const ImU32 disc = earned ? Fade(Rgb(rgb), a) : Fade(CARD_HOVER, a);
+  const ImU32 ink = earned ? Fade(TEXT, a) : Fade(FAINT, a);
+  dl->AddCircleFilled(c, r, disc, 48);
+  if (!earned)
+    dl->AddCircle(c, r, Fade(FAINT, a * 0.55f), 48, std::max(1.5f, r * 0.07f));
+  const float s = r * 0.56f;  // the shapes below are drawn in a -1 to 1 square
+  const auto at = [&](float x, float y) { return ImVec2(c.x + x * s, c.y + y * s); };
+  const auto fill = [&](std::initializer_list<ImVec2> pts) {
+    std::vector<ImVec2> v;
+    for (const ImVec2 p : pts)
+      v.push_back(at(p.x, p.y));
+    dl->AddConcavePolyFilled(v.data(), static_cast<int>(v.size()), ink);
+  };
+  const auto dot = [&](float x, float y, float rad, ImU32 col) { dl->AddCircleFilled(at(x, y), rad * s, col, 24); };
+  const auto line = [&](float x0, float y0, float x1, float y1, float w, ImU32 col) {
+    dl->AddLine(at(x0, y0), at(x1, y1), col, std::max(1.0f, w * s));
+  };
+  const auto flame = [&] {
+    fill({{0, -1}, {0.3f, -0.55f}, {0.65f, -0.1f}, {0.7f, 0.3f}, {0.5f, 0.75f}, {0, 1}, {-0.5f, 0.75f},
+          {-0.7f, 0.3f}, {-0.55f, -0.1f}, {-0.25f, -0.3f}, {-0.15f, -0.65f}});
+    dot(0, 0.5f, 0.3f, disc);
+  };
+  const auto droplet = [&](float ox, float k) {
+    fill({{ox, -1 * k}, {ox + 0.35f * k, -0.45f * k}, {ox + 0.65f * k, 0.05f * k}, {ox + 0.65f * k, 0.4f * k},
+          {ox + 0.45f * k, 0.75f * k}, {ox, 0.95f * k}, {ox - 0.45f * k, 0.75f * k}, {ox - 0.65f * k, 0.4f * k},
+          {ox - 0.65f * k, 0.05f * k}, {ox - 0.35f * k, -0.45f * k}});
+  };
+
+  const std::string kind = name == "type" ? arg : name;
+  if (kind == "rank")
+    TextCentred(dl, true, r * (arg.size() > 1 ? 0.95f : 1.25f), c.x, c.y, ink, arg.c_str());
+  else if (kind == "crown")
+  {
+    fill({{-0.95f, 0.6f}, {-0.95f, -0.55f}, {-0.45f, 0}, {0, -0.85f}, {0.45f, 0}, {0.95f, -0.55f}, {0.95f, 0.6f}});
+    dl->AddRectFilled(at(-0.95f, 0.72f), at(0.95f, 0.95f), ink);
+    if (!arg.empty())
+      TextCentred(dl, true, r * 0.5f, c.x, c.y + 0.12f * s, disc, arg.c_str());
+  }
+  else if (kind == "trophy")
+  {
+    fill({{-0.6f, -0.85f}, {0.6f, -0.85f}, {0.55f, -0.05f}, {0.3f, 0.35f}, {-0.3f, 0.35f}, {-0.55f, -0.05f}});
+    dl->AddCircle(at(-0.78f, -0.4f), 0.3f * s, ink, 16, std::max(1.5f, 0.13f * s));
+    dl->AddCircle(at(0.78f, -0.4f), 0.3f * s, ink, 16, std::max(1.5f, 0.13f * s));
+    dl->AddRectFilled(at(-0.12f, 0.35f), at(0.12f, 0.68f), ink);
+    dl->AddRectFilled(at(-0.45f, 0.68f), at(0.45f, 0.92f), ink);
+  }
+  else if (kind == "star")
+  {
+    std::vector<ImVec2> v;
+    for (int i = 0; i < 10; ++i)
+    {
+      const float ang = (-90.0f + 36.0f * i) * 3.14159265f / 180.0f, rad = (i % 2 == 0) ? 1.0f : 0.42f;
+      v.push_back(at(std::cos(ang) * rad, std::sin(ang) * rad));
+    }
+    dl->AddConcavePolyFilled(v.data(), 10, ink);
+  }
+  else if (kind == "flame" || kind == "fire")
+    flame();
+  else if (kind == "water")
+  {
+    droplet(0, 1);
+    dot(-0.2f, 0.4f, 0.14f, disc);
+  }
+  else if (kind == "poison")
+  {
+    droplet(-0.12f, 0.85f);
+    dot(0.62f, -0.5f, 0.22f, ink);
+    dot(0.8f, -0.05f, 0.14f, ink);
+  }
+  else if (kind == "electric")
+    fill({{0.25f, -1}, {-0.6f, 0.15f}, {-0.05f, 0.15f}, {-0.3f, 1}, {0.65f, -0.25f}, {0.05f, -0.25f}});
+  else if (kind == "grass")
+  {
+    fill({{-0.8f, 0.8f}, {-0.7f, 0.1f}, {-0.3f, -0.45f}, {0.3f, -0.8f}, {0.85f, -0.85f}, {0.8f, -0.2f},
+          {0.5f, 0.4f}, {0, 0.75f}, {-0.5f, 0.85f}});
+    line(-0.75f, 0.85f, 0.55f, -0.6f, 0.11f, disc);
+  }
+  else if (kind == "ice")
+  {
+    for (int i = 0; i < 3; ++i)
+    {
+      const float ang = i * 60.0f * 3.14159265f / 180.0f, x = std::cos(ang), y = std::sin(ang);
+      line(-0.9f * x, -0.9f * y, 0.9f * x, 0.9f * y, 0.16f, ink);
+      dot(0.9f * x, 0.9f * y, 0.13f, ink);
+      dot(-0.9f * x, -0.9f * y, 0.13f, ink);
+    }
+  }
+  else if (kind == "fighting")
+  {
+    dl->AddRectFilled(at(-0.75f, -0.2f), at(0.75f, 0.85f), ink, 0.25f * s);
+    for (const float x : {-0.52f, -0.17f, 0.18f, 0.53f})
+      dot(x, -0.38f, 0.27f, ink);
+    for (const float x : {-0.35f, 0.0f, 0.35f})
+      line(x, -0.4f, x, 0.15f, 0.07f, disc);
+  }
+  else if (kind == "ground")
+  {
+    fill({{-0.95f, 0.8f}, {-0.3f, -0.6f}, {0.35f, 0.8f}});
+    fill({{-0.1f, 0.8f}, {0.45f, -0.25f}, {0.95f, 0.8f}});
+    line(-0.95f, 0.88f, 0.95f, 0.88f, 0.14f, ink);
+  }
+  else if (kind == "flying")
+    fill({{-0.95f, 0.55f}, {-0.45f, -0.55f}, {0.1f, -0.9f}, {0.95f, -0.7f}, {0.35f, -0.35f}, {0.8f, -0.1f},
+          {0.1f, 0.1f}, {0.55f, 0.5f}, {-0.2f, 0.35f}});
+  else if (kind == "psychic")
+  {
+    fill({{-1, 0}, {-0.55f, -0.5f}, {0, -0.7f}, {0.55f, -0.5f}, {1, 0}, {0.55f, 0.5f}, {0, 0.7f}, {-0.55f, 0.5f}});
+    dot(0, 0, 0.42f, disc);
+    dot(0, 0, 0.2f, ink);
+  }
+  else if (kind == "bug")
+  {
+    dot(0, 0.22f, 0.55f, ink);
+    dot(0, -0.55f, 0.32f, ink);
+    for (const float sign : {-1.0f, 1.0f})
+    {
+      line(sign * 0.45f, 0.0f, sign * 0.98f, -0.15f, 0.1f, ink);
+      line(sign * 0.5f, 0.3f, sign * 1.0f, 0.4f, 0.1f, ink);
+      line(sign * 0.3f, -0.8f, sign * 0.6f, -1.0f, 0.1f, ink);
+    }
+    line(0, -0.2f, 0, 0.75f, 0.07f, disc);
+  }
+  else if (kind == "rock")
+  {
+    fill({{-0.85f, 0.2f}, {-0.5f, -0.7f}, {0.25f, -0.9f}, {0.9f, -0.25f}, {0.65f, 0.7f}, {-0.3f, 0.85f}});
+    line(-0.5f, -0.7f, 0, 0.05f, 0.08f, disc);
+    line(0.25f, -0.9f, 0, 0.05f, 0.08f, disc);
+    line(0, 0.05f, -0.3f, 0.85f, 0.08f, disc);
+  }
+  else if (kind == "ghost")
+  {
+    dot(0, -0.1f, 0.7f, ink);
+    dl->AddRectFilled(at(-0.7f, -0.1f), at(0.7f, 0.7f), ink);
+    for (const float x : {-0.47f, 0.0f, 0.47f})
+      dot(x, 0.7f, 0.235f, ink);
+    dot(-0.25f, -0.15f, 0.15f, disc);
+    dot(0.25f, -0.15f, 0.15f, disc);
+  }
+  else if (kind == "dragon")
+  {
+    fill({{-0.95f, -0.9f}, {-0.35f, -0.1f}, {0.35f, -0.1f}, {0.95f, -0.9f}, {0.75f, 0.25f}, {0, 0.95f},
+          {-0.75f, 0.25f}});
+    dot(-0.28f, 0.2f, 0.1f, disc);
+    dot(0.28f, 0.2f, 0.1f, disc);
+  }
+  else if (kind == "dark")
+  {
+    dot(0, 0, 0.85f, ink);
+    dot(0.4f, -0.3f, 0.72f, disc);
+  }
+  else if (kind == "steel")
+  {
+    fill({{0, -0.95f}, {0.82f, -0.48f}, {0.82f, 0.48f}, {0, 0.95f}, {-0.82f, 0.48f}, {-0.82f, -0.48f}});
+    dot(0, 0, 0.38f, disc);
+  }
+  else  // normal, and anything unknown: a ring with a dot
+  {
+    dl->AddCircle(c, 0.8f * s, ink, 32, std::max(1.5f, 0.22f * s));
+    dot(0, 0, 0.28f, ink);
+  }
+}
